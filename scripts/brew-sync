#!/bin/bash
# brew-sync: Dump current Homebrew state to a tracked Brewfile profile.
#
# Default mode is non-committing:
#   brew-sync
#   brew-sync --profile personal
#   brew-sync --profile corporate
#   brew-sync --profile workstation
#
# Explicit commit mode:
#   brew-sync --commit
#   brew-sync --commit --push

set -euo pipefail

DOTFILES="$HOME/.dotfiles"
PROFILE="personal"
COMMIT=false
PUSH=false

while [ $# -gt 0 ]; do
  case "$1" in
    --profile)
      [ $# -ge 2 ] || { echo "Missing value for --profile" >&2; exit 2; }
      PROFILE="$2"
      shift 2
      ;;
    --commit) COMMIT=true; shift ;;
    --push) PUSH=true; COMMIT=true; shift ;;
    -h|--help)
      sed -n '2,13p' "$0" | sed 's/^# \?//'
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

case "$PROFILE" in
  personal) BREWFILE="$DOTFILES/macos/Brewfile" ;;
  corporate) BREWFILE="$DOTFILES/macos/Brewfile.corporate" ;;
  workstation) BREWFILE="$DOTFILES/macos/Brewfile.workstation" ;;
  *) echo "Unknown profile: $PROFILE" >&2; exit 2 ;;
esac

if ! command -v brew >/dev/null 2>&1; then
  echo "brew-sync: Homebrew is not installed" >&2
  exit 1
fi

echo "brew-sync: dumping Homebrew state for $PROFILE to $BREWFILE"
brew bundle dump --file="$BREWFILE" --force

cd "$DOTFILES"
if git diff --quiet "$BREWFILE" 2>/dev/null; then
  echo "brew-sync: no Brewfile changes"
  exit 0
fi

echo "brew-sync: Brewfile changed"
git --no-pager diff -- "$BREWFILE"

if [ "$COMMIT" != true ]; then
  echo ""
  echo "brew-sync: not committing. Re-run with --commit to commit, or --commit --push to push."
  exit 0
fi

git add "$BREWFILE"
git commit -m "brew-sync: update Brewfile $(date +%Y-%m-%d)"

if [ "$PUSH" = true ]; then
  git push
else
  echo "brew-sync: committed locally. Re-run with --commit --push to push."
fi
