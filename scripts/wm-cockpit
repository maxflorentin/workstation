#!/usr/bin/env bash
# wm-cockpit — one fzf screen of all worktrees x PR state, across repos.
# Native-first: workmux + gh + fzf. No daemon; polls on invoke and on refresh.
#
# Interfaces captured 2026-08-03:
#   workmux list --json  -> [{handle,branch,path,is_open,is_main,
#                             has_uncommitted_changes,mode,created_at}]  (per-repo)
#   gh pr list --state all --json number,state,headRefName,statusCheckRollup
#                        -> [{number,state,headRefName,statusCheckRollup:[{conclusion}]}]
# `workmux list --json` does NOT carry PR data even with --pr, so PRs come from
# one `gh pr list` per repo (cheaper than `gh pr view` per branch).
set -euo pipefail

REPOS="${WM_REPOS:-$HOME/repos}"

icon() { case "$1" in
  MERGED) printf '✅';; OPEN) printf '🔵';; CLOSED) printf '⚫';; *) printf '❔';;
esac; }

# repo handle branch state ci prnum -> "repo:handle<TAB>display"
# First field (key) is stable: actions split on ':' to get repo and handle.
_cockpit_row() {
  printf '%s:%s\t%s %-15s %-40s PR#%-5s %-7s %s\n' \
    "$1" "$2" "$(icon "$4")" "$1" "$3" "${6:-?}" "$4" "${5:-?}"
}

# Self-test hook so smoke.sh can exercise _cockpit_row without workmux/gh.
if [ "${WM_COCKPIT_SELFTEST:-}" = "1" ] && [ "${1:-}" = "__rowtest" ]; then
  shift; _cockpit_row "$1" "$2" "$3" "$4" "$5" "$6"; exit 0
fi

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wm-cockpit"
LOG="$STATE_DIR/closed.log"

# repo branch prnum title -> "ISO8601<TAB>repo<TAB>branch<TAB>PR#<n><TAB>title"
_logline() {
  printf '%s\t%s\t%s\tPR#%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$4"
}

if [ "${WM_COCKPIT_SELFTEST:-}" = "1" ] && [ "${1:-}" = "__logline" ]; then
  shift; _logline "$1" "$2" "$3" "$4"; exit 0
fi

# Emit "handle<TAB>branch<TAB>state<TAB>ci<TAB>prnum" for each worktree of a repo.
# Degrades to state=no-pr/unknown when gh is unavailable; never fails the screen.
# NOTE: WT/PR json can exceed MAX_ARG_STRLEN (128KB, a single env var's cap,
# distinct from the larger total ARG_MAX) for repos with heavy PR history —
# so pass them as files, not env vars, or python3 exec silently fails.
_repo_rows() { # repo_dir
  local dir="$1" wt_file pr_file
  wt_file="$(mktemp)"; pr_file="$(mktemp)"
  ( cd "$dir" && workmux list --json 2>/dev/null || echo '[]' ) > "$wt_file"
  ( cd "$dir" && gh pr list --state all --limit 200 \
        --json number,state,headRefName,statusCheckRollup 2>/dev/null || echo '[]' ) > "$pr_file"
  WT_FILE="$wt_file" PR_FILE="$pr_file" python3 - <<'PY'
import json, os
with open(os.environ["WT_FILE"]) as f:
    wt = json.load(f) or []
with open(os.environ["PR_FILE"]) as f:
    prs = {p.get("headRefName"): p for p in (json.load(f) or [])}
def ci(p):
    c = [x.get("conclusion") for x in (p.get("statusCheckRollup") or []) if isinstance(x, dict)]
    if not c: return "-"
    if "FAILURE" in c: return "ci:fail"
    if all(x == "SUCCESS" for x in c): return "ci:ok"
    return "ci:…"
for w in wt:
    br = w.get("branch", "")
    p = prs.get(br)
    if p:
        state, num, cir = p.get("state", "?"), p.get("number", "?"), ci(p)
    else:
        state, num, cir = "no-pr", "?", "-"
    print("\t".join([w.get("handle", ""), br, state, cir, str(num)]))
PY
  rm -f "$wt_file" "$pr_file"
}

# Emit the display rows for one repo (combines _repo_rows + _cockpit_row).
_repo_display() { # repo_dir repo_name
  local dir="$1" repo="$2" handle branch state ci prnum
  while IFS=$'\t' read -r handle branch state ci prnum; do
    [ -n "$handle" ] || continue
    _cockpit_row "$repo" "$handle" "$branch" "$state" "$ci" "$prnum"
  done < <(_repo_rows "$dir")
}

# Gather all repos in parallel (each does a gh round-trip). Output is ordered
# by repo so the list is stable across refreshes; wall-clock ~= the slowest repo.
gather() {
  local dir repo i=0 tmpd
  tmpd="$(mktemp -d)"
  for dir in "$REPOS"/*/; do
    [ -e "$dir/.git" ] || continue
    repo="$(basename "$dir")"
    _repo_display "$dir" "$repo" > "$tmpd/$(printf '%03d' "$i")" &
    i=$((i + 1))
  done
  wait || true   # a slow/failing repo must not abort the whole gather
  cat "$tmpd"/* 2>/dev/null
  rm -rf "$tmpd"
}

# --- actions (invoked as sub-commands from the fzf bindings) ---

_branch_of() { # repo_dir handle -> branch
  local wt
  wt="$(cd "$1" && workmux list --json 2>/dev/null)"
  [ -n "$wt" ] || wt='[]'
  WT="$wt" H="$2" python3 -c \
    'import json,os; d=json.loads(os.environ["WT"]); print(next((w.get("branch","") for w in d if w.get("handle")==os.environ["H"]), ""))'
}

# Detached, best-effort: update this repo's Claude memory to mark the merged
# initiative shipped. Runs in the repo dir so it uses that project's memory.
# nohup so it survives the cockpit exiting; failure never blocks the close.
fire_memory_update() { # repo_dir branch prnum title
  ( cd "$1" && nohup claude -p "Worktree $2 (PR #$3: $4) merged and shipped. Update this project's memory (MEMORY.md and the relevant project_*.md) to mark the initiative done. Memory only — do not touch code or anything else." >/dev/null 2>&1 & )
}

# Default branch of the repo (origin/HEAD, falling back to main/master).
_default_branch() { # repo_dir -> branch name
  local d="$1" ref
  ref="$(git -C "$d" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$ref" ]; then printf '%s\n' "${ref#refs/remotes/origin/}"; return; fi
  local b
  for b in main master; do
    git -C "$d" show-ref -q "refs/heads/$b" && { printf '%s\n' "$b"; return; }
  done
  printf 'main\n'
}

do_close() { # repo handle  — refuses unless the PR is MERGED, or the branch
             # (no PR — direct-push workflow) is merged into the default branch.
  local repo="$1" handle="$2" dir="$REPOS/$1" branch info state num title main
  branch="$(_branch_of "$dir" "$handle")"
  [ -n "$branch" ] || { printf 'no branch for %s\n' "$handle" >&2; sleep 1; return 1; }
  info="$( cd "$dir" && gh pr view "$branch" --json state,number,title \
           -q '.state + "\t" + (.number|tostring) + "\t" + .title' 2>/dev/null )" || info=""
  IFS=$'\t' read -r state num title <<<"$info"
  if [ "${state:-}" != "MERGED" ]; then
    main="$(_default_branch "$dir")"
    git -C "$dir" fetch -q origin "$main" 2>/dev/null || true
    if ! git -C "$dir" merge-base --is-ancestor "$branch" "origin/$main" 2>/dev/null \
       && ! git -C "$dir" merge-base --is-ancestor "$branch" "$main" 2>/dev/null; then
      printf 'refusing: PR state is %s and branch not merged into %s\n' "${state:-unknown}" "$main" >&2
      sleep 1.2; return 1
    fi
    num="${num:-?}"; title="${title:-merged into $main}"
  fi
  mkdir -p "$STATE_DIR"
  _logline "$repo" "$branch" "$num" "$title" >> "$LOG"
  fire_memory_update "$dir" "$branch" "$num" "$title"
  ( cd "$dir" && workmux remove -f "$handle" )
}

do_mergeinto() { # repo handle  — merge a chosen branch INTO the worktree's branch
  local dir="$REPOS/$1" path cur dest
  path="$( cd "$dir" && workmux path "$2" 2>/dev/null )" || { printf 'no path for %s\n' "$2" >&2; sleep 1; return 1; }
  cur="$(git -C "$path" rev-parse --abbrev-ref HEAD)"
  dest="$(git -C "$path" for-each-ref --format='%(refname:short)' refs/heads \
          | grep -vx "$cur" | fzf --prompt="merge INTO $cur from> ")" || return 0
  [ -n "$dest" ] || return 0
  git -C "$path" merge "$dest" || { printf 'conflict — resolve in %s then commit\n' "$path" >&2; sleep 2; return 1; }
}

# --- cache: reopening the cockpit is instant within TTL; ctrl-r / close /
#     merge always force a fresh gather (and refresh the cache). ---
CACHE="$STATE_DIR/rows.cache"
CACHE_TTL="${WM_COCKPIT_TTL:-90}"   # seconds
_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
_fresh()  { mkdir -p "$STATE_DIR"; gather | tee "$CACHE"; }
_cached() {
  if [ -f "$CACHE" ] && [ "$(( $(date +%s) - $(_mtime "$CACHE") ))" -lt "$CACHE_TTL" ]; then
    cat "$CACHE"
  else
    _fresh
  fi
}

case "${1:-}" in
  __gather)    _fresh; exit 0 ;;
  __open)      shift; ( cd "$REPOS/$1" && workmux open "$2" ); exit $? ;;
  __close)     shift; do_close "$1" "$2"; exit $? ;;
  __mergeinto) shift; do_mergeinto "$1" "$2"; exit $? ;;
esac

export SELF="$0"
_cached | fzf --with-nth=2.. --delimiter=$'\t' \
  --header 'enter: jump · c: close(PR merged or branch merged) · m: merge-into · ctrl-r: refresh' \
  --bind 'ctrl-r:reload("$SELF" __gather)' \
  --bind 'enter:execute-silent(k={1}; tmux run-shell -b "\"$SELF\" __open \"${k%%:*}\" \"${k#*:}\"")+abort' \
  --bind 'c:execute(k={1}; "$SELF" __close "${k%%:*}" "${k#*:}" || true)+reload("$SELF" __gather)' \
  --bind 'm:execute(k={1}; "$SELF" __mergeinto "${k%%:*}" "${k#*:}" || true)+reload("$SELF" __gather)' \
  || true
