# Dotfiles
export DOTFILES=$HOME/.dotfiles

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # Timestamps in history
setopt SHARE_HISTORY          # Share between sessions
setopt HIST_IGNORE_DUPS       # No consecutive duplicates
setopt HIST_IGNORE_ALL_DUPS   # Remove older duplicate
setopt HIST_REDUCE_BLANKS     # Trim whitespace
setopt HIST_VERIFY            # Show before executing !command
HIST_STAMPS="yyyy-mm-dd"

# Directory navigation
setopt AUTO_CD                # cd by typing directory name
setopt AUTO_PUSHD             # Push dirs to stack on cd
setopt PUSHD_IGNORE_DUPS      # No duplicate dirs in stack
setopt PUSHD_SILENT           # Don't print stack on pushd

# Completion
autoload -Uz compinit
# Only regenerate completion dump once per day
if [[ ! -f "$HOME/.zcompdump" || -n $HOME/.zcompdump(#qN.mh+24) ]]; then
  compinit -i
else
  compinit -C -i
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zcompcache"

# Key bindings (emacs mode - default)
bindkey -e
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^[[A' history-beginning-search-backward-end   # Arrow up (xterm)
bindkey '^[[B' history-beginning-search-forward-end     # Arrow down (xterm)
bindkey '^[OA' history-beginning-search-backward-end    # Arrow up (application mode)
bindkey '^[OB' history-beginning-search-forward-end     # Arrow down (application mode)
bindkey '^P' history-beginning-search-backward-end      # Ctrl-P fallback
bindkey '^N' history-beginning-search-forward-end       # Ctrl-N fallback

# Environment
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export EDITOR="nvim"
# Docker (macOS uses podman socket, Linux uses native Docker)
if [[ "$(uname)" == "Darwin" ]]; then
    export DOCKER_HOST="${DOCKER_HOST:-unix:///var/folders/c5/t8d_gq6s553_s5msp76hcc600000gn/T/podman/podman-machine-default-api.sock}"
fi

# Load dotfiles config
source "$DOTFILES/shell/path.zsh"
source "$DOTFILES/shell/aliases.zsh"

if command -v brew >/dev/null 2>&1; then
    HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-$(brew --prefix 2>/dev/null)}"
fi

# tmux/tau project discovery
if [[ -z "${TMUX_PROJECT_DIRS:-}" ]]; then
    export TMUX_PROJECT_DIRS="$HOME/repos:$HOME/Developer:$DOTFILES"
fi
if [[ -z "${TAU_PROJECT_DIR:-}" ]]; then
    for dir in "$HOME/repos" "$HOME/Developer"; do
        [[ -d "$dir" ]] && export TAU_PROJECT_DIR="$dir" && break
    done
fi
export TAU_EDITOR_CMD="${TAU_EDITOR_CMD:-${EDITOR:-nvim}}"
export TAU_GIT_CMD="${TAU_GIT_CMD:-lazygit}"

# Autojump
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/etc/profile.d/autojump.sh" ]]; then
    . "$HOMEBREW_PREFIX/etc/profile.d/autojump.sh"
elif [ -f /usr/share/autojump/autojump.zsh ]; then
    . /usr/share/autojump/autojump.zsh
fi

# Syntax highlighting
if [[ -n "${ZSH_SYNTAX_HIGHLIGHTING:-}" && -f "$ZSH_SYNTAX_HIGHLIGHTING" ]]; then
    source "$ZSH_SYNTAX_HIGHLIGHTING"
elif [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Auto-activate Python venvs
# Must be set BEFORE any venv is activated so deactivate never clobbers PS1
export VIRTUAL_ENV_DISABLE_PROMPT=1
autoload -U add-zsh-hook

auto_activate_venv() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        local venv_dir=$(dirname "$VIRTUAL_ENV")
        if [[ "$PWD"/ != "$venv_dir"/* ]] && [[ "$PWD" != "$venv_dir" ]]; then
            deactivate 2>/dev/null
        fi
    fi

    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.venv/bin/activate" ]]; then
            if [[ "$VIRTUAL_ENV" != "$dir/.venv" ]]; then
                source "$dir/.venv/bin/activate"
            fi
            return
        fi
        dir=$(dirname "$dir")
    done
}

add-zsh-hook chpwd auto_activate_venv
auto_activate_venv

# UV setup (lazy)
uv-up() {
    source "${UV_SETUP_SCRIPT:-$DOTFILES/scripts/uv-setup}"
}

# AWS profile switcher
asp() {
  local profile=$(aws configure list-profiles | fzf --height 40% --layout=reverse --border)
  if [[ -n "$profile" ]]; then
    export AWS_PROFILE=$profile
    echo "AWS Profile set to: $AWS_PROFILE"
  fi
}

unasp() {
  unset AWS_PROFILE
  echo "AWS_PROFILE unset."
}

# Starship prompt
export STARSHIP_CONFIG="$DOTFILES/shell/starship.toml"
eval "$(starship init zsh)"

# Google Cloud SDK
if [ -f "$HOME/repos/gcp/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/repos/gcp/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/repos/gcp/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/repos/gcp/google-cloud-sdk/completion.zsh.inc"; fi

# Client profile (per-user on the Pi; no-op on the Mac / admin users)
[ -f "$HOME/.clientrc" ] && source "$HOME/.clientrc"

# Route Claude Code to local oc-go-cc proxy if enabled
if [[ "${WORK_CLIENT_OPENCODE_PROXY:-0}" == "1" ]]; then
    export ANTHROPIC_BASE_URL="http://127.0.0.1:3456"
    export ANTHROPIC_AUTH_TOKEN="unused"
fi

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Give xclip (and Claude Code's own clipboard check) a real X11 clipboard to
# read on this headless box. Each user gets a private virtual display keyed
# off their UID, matching what clip-recv uses when the Mac pushes into it.
if [[ "$(uname -s)" == "Linux" ]] && [[ -z "${DISPLAY:-}" ]]; then
    export DISPLAY=":$(( $(id -u) + 50 ))"
fi

# Startup: shells opened directly in ~/repos should land in tmux.
# Disable for one shell with: TMUX_AUTO_ATTACH=0 zsh
if [[ -o interactive ]] &&
   [[ -z "${TMUX:-}" ]] &&
   [[ "${TMUX_AUTO_ATTACH:-1}" != "0" ]] &&
   [[ "$PWD" == "$HOME/repos" ]] &&
   command -v tmux >/dev/null 2>&1; then
    exec tmux new-session -A -s repos -c "$HOME/repos"
fi

# opencode
export PATH=/home/max/.opencode/bin:$PATH
