#!/usr/bin/env bash
# clip-watch: poll the Mac clipboard and auto-push changes to the remote
# workstation's clipboard (see clip-push, linux/clip-recv). Run persistently
# by com.dotfiles.clip-watch.plist so Ctrl+V for images just works without a
# manual step. Disable by unloading that LaunchAgent.
set -euo pipefail

target="${CLIP_PUSH_TARGET:-workstation}"
push="$HOME/.local/bin/clip-push"
last=""

while true; do
    # pngpaste exits non-zero when the clipboard holds text instead of an
    # image (the common case) — under pipefail + set -e that would kill the
    # whole loop on every text copy, so both branches are guarded with
    # `|| true`.
    cur="$({ pbpaste 2>/dev/null || true; command -v pngpaste >/dev/null 2>&1 && pngpaste - 2>/dev/null || true; } | md5)"
    if [ "$cur" != "$last" ]; then
        last="$cur"
        "$push" "$target" >/dev/null 2>&1 || true
    fi
    sleep 1
done
