# Media stack configuration.
#
# Copy to .env in this directory (already gitignored) and edit, or just run
# `media setup` which creates it and fills PUID/PGID for you.

# --- Storage (the 512 GB external disk) ---------------------------------------
# Mount point of the external disk. Everything below lives under it so the
# root SSD stays lean and Plex metadata sits next to the media.
STORAGE=/mnt/media
# Media library Plex scans (movies/, tv/, music/, ... go inside).
MEDIA=/mnt/media/library
# App config + databases (Plex DB, transmission, flexget). Kept off the root SSD.
CONFIG=/mnt/media/config
# Transcode scratch dir. Tiny with direct play; on the external disk regardless.
TRANSCODE=/mnt/media/tmp

# --- Identity / locale --------------------------------------------------------
# Filesystem ownership for files the containers create. `media setup` sets
# these to the `media` system user it creates. Don't guess; let setup fill them.
PUID=
PGID=
TZ=America/Argentina/Mendoza

# --- Plex ---------------------------------------------------------------------
# First-run claim token from https://plex.tv/claim (valid ~4 minutes). Leave
# blank after the server is claimed; only needed to link a fresh install.
PLEX_CLAIM=

# --- Transmission web UI (http://<host>:9091) ---------------------------------
TRANSMISSION_USER=admin
TRANSMISSION_PASS=changeme

# --- Flexget web UI (http://<host>:5050) --------------------------------------
FLEXGET_PASSWD=changeme

# --- Samba share credentials (smb://<host>) -----------------------------------
SAMBA_USER=media
SAMBA_PASS=changeme
