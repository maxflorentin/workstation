# --- backup-doctor ---
# Non-destructive backup/recovery readiness checks. This does not copy data.
cmd_backup_doctor() {
    local failures=0
    local warnings=0
    local admin_sudo=0

    _ok() { echo "ok   $*"; }
    _warn() { echo "warn $*"; warnings=$((warnings + 1)); }
    _fail() { echo "fail $*"; failures=$((failures + 1)); }

    echo "backup doctor"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    echo ""

    echo "== Reachability =="
    if ! _ssh_quiet "echo ok" >/dev/null; then
        _fail "ssh unreachable at $WORKSTATION_HOSTNAME"
        echo ""
        echo "backup doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi
    _ok "ssh reachable"

    if _ssh_quiet "sudo -n true"; then
        _ok "passwordless sudo available for privileged backup checks"
        admin_sudo=1
    else
        echo "info passwordless sudo unavailable; privileged checks will be limited"
        echo "info run on workstation with sudo for full verification: sudo ~/.local/bin/work backup-doctor"
    fi

    echo ""
    echo "== Core Data =="
    local admin_home
    admin_home=$(_ssh_quiet "getent passwd '$WORKSTATION_ADMIN_USER' | cut -d: -f6" || true)
    if [ -z "$admin_home" ]; then
        _fail "could not resolve admin home for $WORKSTATION_ADMIN_USER"
        admin_home="/home/$WORKSTATION_ADMIN_USER"
    fi
    if _ssh_quiet "test -d '$admin_home/.dotfiles' && test -d '$admin_home/.dotfiles/.git'"; then
        _ok "admin dotfiles repo exists"
    else
        _fail "admin dotfiles repo missing"
    fi
    if _ssh_quiet "test -d '$admin_home/.ssh'"; then
        _ok "admin ~/.ssh exists"
    else
        _warn "admin ~/.ssh missing"
    fi
    if _ssh_quiet "test -d '$admin_home/.envy'"; then
        _ok "admin ~/.envy exists"
    else
        _warn "admin ~/.envy missing"
    fi

    echo ""
    echo "== Client Homes =="
    local clients
    clients=$(_list_clients || true)
    if [ -z "$clients" ]; then
        _warn "no client users found"
    else
        while IFS= read -r client; do
            [ -z "$client" ] && continue
            local home_mode home_fs
            home_mode=$(_ssh_quiet "stat -c %a /home/$client 2>/dev/null" || true)
            home_fs=$(_ssh_quiet "findmnt -no FSTYPE /home/$client 2>/dev/null" || true)
            if [ "$home_mode" = "700" ]; then
                _ok "$client home mode 700"
            else
                _warn "$client home mode ${home_mode:-unknown}, expected 700"
            fi
            if [ "$home_fs" = "ecryptfs" ]; then
                _ok "$client home mounted as ecryptfs"
            elif [ -n "$home_fs" ]; then
                echo "info $client home fstype $home_fs"
            else
                echo "info $client home is not a separate mount"
            fi
        done <<< "$clients"
    fi

    echo ""
    echo "== Privileged State =="
    if [ "$admin_sudo" -eq 1 ]; then
        if _ssh_quiet "sudo -n test -d /etc/ssh/authorized_keys"; then
            _ok "/etc/ssh/authorized_keys exists"
        else
            _warn "/etc/ssh/authorized_keys missing"
        fi
        if _ssh_quiet "sudo -n test -d /etc/ecryptfs"; then
            _ok "/etc/ecryptfs exists"
        else
            _warn "/etc/ecryptfs missing"
        fi
        if _ssh_quiet "sudo -n find /home/.ecryptfs -mindepth 1 -maxdepth 1 -type d 2>/dev/null | grep -q ."; then
            _ok "/home/.ecryptfs has encrypted homes"
        else
            _warn "/home/.ecryptfs missing or empty"
        fi
        if _ssh_quiet "sudo -n find /etc/systemd/system -maxdepth 1 -name 'tailscaled-*.service' 2>/dev/null | grep -q ."; then
            _ok "secondary Tailscale systemd units present"
        else
            _warn "no secondary Tailscale units found"
        fi
        if _ssh_quiet "sudo -n find /usr/local/bin -maxdepth 1 -name 'tailscale-*' 2>/dev/null | grep -q ."; then
            _ok "secondary Tailscale wrappers present"
        else
            _warn "no secondary Tailscale wrappers found"
        fi
        if _ssh_quiet "sudo -n test -d /var/ossec"; then
            _ok "Wazuh state present"
        else
            _warn "Wazuh state missing"
        fi
    else
        echo "info skipped privileged state checks"
    fi

    echo ""
    echo "== Backup Target =="
    if [ -n "${WORK_BACKUP_TARGET:-}" ]; then
        if _ssh_quiet "test -d '$WORK_BACKUP_TARGET'"; then
            _ok "WORK_BACKUP_TARGET exists"
            if _ssh_quiet "test -f '$WORK_BACKUP_TARGET/README.restore.md'"; then
                _ok "backup restore README present"
            else
                _warn "backup restore README missing"
            fi
            if _ssh_quiet "test -f '$WORK_BACKUP_TARGET/MANIFEST.tsv'"; then
                _ok "backup manifest present"
                if _ssh_quiet "head -n 1 '$WORK_BACKUP_TARGET/MANIFEST.tsv' | grep -qx 'timestamp	client	status	path	bytes	sha256	label'"; then
                    _ok "backup manifest schema current"
                else
                    _warn "backup manifest schema is missing bytes/sha256 columns"
                fi
            else
                _warn "backup manifest missing"
            fi
            if _ssh_quiet "test -d '$WORK_BACKUP_TARGET/clients'"; then
                _ok "backup clients directory present"
            else
                _warn "backup clients directory missing"
            fi
            if _ssh_quiet "test -d '$WORK_BACKUP_TARGET/workstation'"; then
                _ok "backup workstation directory present"
            else
                _warn "backup workstation directory missing"
            fi
        else
            _warn "WORK_BACKUP_TARGET not found on workstation"
        fi
    else
        _warn "WORK_BACKUP_TARGET not set"
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "backup doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "backup doctor passed: $warnings warning(s)"
}

# --- config-backup ---
# Export restore-critical config to an external private repo, encrypted with age.
# This intentionally excludes client data.
cmd_config_backup() {
    local dry_run=0
    if [ "${1:-}" = "--dry-run" ]; then
        dry_run=1
        shift
    fi

    local client="${1:-}"
    local dest="${2:-}"
    shift 2 2>/dev/null || true
    local recipient="$*"
    local failures=0
    local warnings=0
    local dry_prefix=""
    [ "$dry_run" -eq 1 ] && dry_prefix="--dry-run "

    _ok() { echo "ok   $*"; }
    _warn() { echo "warn $*"; warnings=$((warnings + 1)); }
    _fail() { echo "fail $*"; failures=$((failures + 1)); }

    if [ -z "$client" ] || [ -z "$dest" ] || [ -z "$recipient" ]; then
        echo "Usage: work config-backup [--dry-run] <client> <dest-dir> <age-recipient>"
        echo ""
        echo "Run this on the workstation. Use sudo for root-owned config:"
        echo "  sudo ~/.local/bin/work config-backup <client> /path/to/private-config-backup 'age1...'"
        echo ""
        echo "For SSH recipients, quote the whole public key."
        exit 1
    fi
    _validate_client_name "$client"

    echo "config backup"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    echo "  client:      $client"
    echo "  target:      $dest"
    [ "$dry_run" -eq 1 ] && echo "  mode:        dry-run"
    echo ""

    if ! _is_local_workstation; then
        _fail "config-backup must run on the workstation so root-owned files stay local"
        echo "     ssh $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
        echo "     sudo ~/.local/bin/work config-backup ${dry_prefix}$client /path/to/private-config-backup '<age-recipient>'"
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        _fail "config-backup requires sudo to read client homes and root-owned config"
        echo "     sudo ~/.local/bin/work config-backup ${dry_prefix}$client '$dest' '<age-recipient>'"
        exit 1
    fi

    if ! command -v age >/dev/null 2>&1; then
        _fail "missing command: age"
        echo ""
        echo "config backup failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    if ! id "$client" >/dev/null 2>&1; then
        _fail "client user does not exist"
        echo ""
        echo "config backup failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    local dest_abs repo_abs client_dir workstation_dir tmp_dir generated_at manifest
    if [ -d "$dest" ]; then
        dest_abs="$(cd "$dest" && pwd -P)"
    else
        local dest_parent dest_base
        dest_parent="$(dirname "$dest")"
        dest_base="$(basename "$dest")"
        if [ ! -d "$dest_parent" ]; then
            _fail "target parent does not exist: $dest_parent"
            echo ""
            if [ "$dry_run" -eq 1 ]; then
                echo "config backup dry-run failed: $failures failure(s), $warnings warning(s)"
            else
                echo "config backup failed: $failures failure(s), $warnings warning(s)"
            fi
            exit 1
        fi
        dest_abs="$(cd "$dest_parent" && pwd -P)/$dest_base"
    fi
    repo_abs="$(cd "$(dirname "$0")/.." && pwd -P)"

    case "$dest_abs" in
        "$repo_abs"|"$repo_abs"/*|"/home/$client"|"/home/$client"/*)
            _fail "target must be outside this sanitized repo and outside the client home"
            echo ""
            echo "config backup failed: $failures failure(s), $warnings warning(s)"
            exit 1
            ;;
    esac

    [ "$dry_run" -eq 1 ] || mkdir -p "$dest_abs"

    if [ "$dry_run" -eq 1 ]; then
        echo "== Dry Run =="
        _ok "client user exists"
        _ok "target is outside sanitized repo and client home"
        if [ -e "$dest_abs" ]; then
            if [ -d "$dest_abs" ] && [ -w "$dest_abs" ]; then
                _ok "target directory writable"
            else
                _fail "target exists but is not a writable directory"
            fi
        else
            local dest_abs_parent
            dest_abs_parent="$(dirname "$dest_abs")"
            if [ -w "$dest_abs_parent" ]; then
                _ok "target parent writable"
            else
                _fail "target parent not writable"
            fi
        fi
        if [ -r "/home/$client/.clientrc" ]; then
            _ok "required client .clientrc readable"
        else
            _fail "required client .clientrc unreadable"
        fi

        echo ""
        if [ "$failures" -gt 0 ]; then
            echo "config backup dry-run failed: $failures failure(s), $warnings warning(s)"
            exit 1
        fi
        echo "config backup dry-run passed: $warnings warning(s)"
        return 0
    fi

    client_dir="$dest_abs/clients/$client"
    workstation_dir="$dest_abs/workstation"
    mkdir -p "$client_dir" "$workstation_dir"
    tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/work-config-backup.XXXXXX")"
    trap 'rm -rf "$tmp_dir"' RETURN
    generated_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    manifest="$dest_abs/MANIFEST.tsv"
    printf 'timestamp\tclient\tstatus\tpath\tbytes\tsha256\tlabel\n' > "$manifest"

    _manifest_path() {
        local path="$1"
        case "$path" in
            "$dest_abs"/*) printf '%s' "${path#"$dest_abs"/}" ;;
            *) printf '%s' "$path" ;;
        esac
    }

    _manifest_entry() {
        local status="$1"
        local path="$2"
        local label="$3"
        local bytes="-"
        local sha256="-"
        if [ -f "$path" ]; then
            bytes="$(stat -c %s "$path" 2>/dev/null || printf '-')"
            sha256="$(sha256sum "$path" 2>/dev/null | awk '{print $1}')"
            [ -n "$sha256" ] || sha256="-"
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$generated_at" "$client" "$status" "$(_manifest_path "$path")" "$bytes" "$sha256" "$label" >> "$manifest"
    }

    _encrypt_file() {
        local src="$1"
        local out="$2"
        local label="$3"
        local required="${4:-optional}"
        local out_tmp="$out.tmp"

        if [ -r "$src" ]; then
            if age -r "$recipient" -o "$out_tmp" "$src"; then
                mv "$out_tmp" "$out"
                chmod 600 "$out"
                _ok "$label"
                _manifest_entry "ok" "$out" "$label"
            else
                rm -f "$out_tmp"
                _fail "$label could not be encrypted"
                _manifest_entry "failed" "$out" "$label"
            fi
        elif [ "$required" = "required" ]; then
            _fail "$label unreadable: $src"
            _manifest_entry "failed" "$out" "$label"
        else
            _warn "$label skipped: $src unreadable or missing"
            _manifest_entry "skipped" "$out" "$label"
        fi
    }

    _encrypt_capture() {
        local out="$1"
        local label="$2"
        local required="${3:-optional}"
        shift 3
        local tmp
        local out_tmp="$out.tmp"
        tmp="$tmp_dir/$(basename "$out").plain"

        if "$@" > "$tmp" && [ -s "$tmp" ]; then
            if age -r "$recipient" -o "$out_tmp" "$tmp"; then
                mv "$out_tmp" "$out"
                chmod 600 "$out"
                _ok "$label"
                _manifest_entry "ok" "$out" "$label"
            else
                rm -f "$out_tmp"
                _fail "$label could not be encrypted"
                _manifest_entry "failed" "$out" "$label"
            fi
        elif [ "$required" = "required" ]; then
            _fail "$label could not be captured"
            _manifest_entry "failed" "$out" "$label"
        else
            _warn "$label skipped: unavailable"
            _manifest_entry "skipped" "$out" "$label"
        fi
    }

    echo "== Client Config =="
    _encrypt_file "/home/$client/.clientrc" "$client_dir/clientrc.age" "client .clientrc" "required"
    _encrypt_file "/usr/local/bin/tailscale-$client" "$client_dir/tailscale-wrapper.age" "secondary Tailscale wrapper"
    _encrypt_file "/etc/systemd/system/tailscaled-$client.service" "$client_dir/tailscale-unit.age" "secondary Tailscale unit"

    echo ""
    echo "== Compliance Config =="
    _encrypt_capture "$client_dir/wazuh-syscheck.age" "Wazuh syscheck scope" "optional" \
        awk '/<syscheck>/,/<\/syscheck>/' /var/ossec/etc/ossec.conf
    # shellcheck disable=SC2016
    _encrypt_capture "$client_dir/dns-filtering.age" "DNS filtering config" "optional" \
        bash -lc '
set -e
found=0
for file in /etc/dnsmasq.conf /etc/dnsmasq.d/*.conf /etc/systemd/resolved.conf; do
    [ -f "$file" ] && [ -r "$file" ] || continue
    found=1
    printf "\n### %s\n" "$file"
    sed -n "1,220p" "$file"
done
[ "$found" -eq 1 ]
'
    _encrypt_capture "$client_dir/compliance-latest.age" "latest compliance doctor output" "optional" \
        "$0" compliance-doctor "$client"

    echo ""
    echo "== Workstation Config =="
    # shellcheck disable=SC2016
    _encrypt_capture "$workstation_dir/ssh-authorized-keys.age" "SSH authorized keys config" "optional" \
        bash -lc '
set -e
found=0
for file in /etc/ssh/authorized_keys/* /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf; do
    [ -f "$file" ] && [ -r "$file" ] || continue
    found=1
    printf "\n### %s\n" "$file"
    sed -n "1,220p" "$file"
done
[ "$found" -eq 1 ]
'
    # shellcheck disable=SC2016
    _encrypt_capture "$workstation_dir/systemd-client-units.age" "client-related systemd units" "optional" \
        bash -lc '
set -e
found=0
for file in /etc/systemd/system/tailscaled-*.service; do
    [ -f "$file" ] && [ -r "$file" ] || continue
    found=1
    printf "\n### %s\n" "$file"
    sed -n "1,220p" "$file"
done
[ "$found" -eq 1 ]
'

    cat > "$dest_abs/README.restore.md" <<EOF
# Private Config Backup

Generated: $generated_at

This repo stores encrypted, restore-critical configuration only.
Do not commit plaintext client data or encryption keys here.

Restore outline:

1. Clone the workstation repo and run ./install.
2. Recreate the client user: $client.
3. Decrypt only the files needed for that restore.
4. Restore service config, then re-authenticate external services as needed.
5. Run: sudo ~/.local/bin/work compliance-doctor $client
EOF
    chmod 600 "$dest_abs/README.restore.md"
    _ok "restore README updated"
    chmod 600 "$manifest"
    _ok "backup manifest updated"

    if [ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ]; then
        chown -R "$SUDO_UID:$SUDO_GID" "$dest_abs"
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "config backup failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "config backup completed: $warnings warning(s)"
}

# --- doctor ---
# Non-destructive workstation checks: SSH, shell startup, core commands,
# services, resources, dotfiles install, and optional client user hygiene.
cmd_doctor() {
    local client="${1:-}"
    local failures=0
    local warnings=0
    local admin_sudo=0

    _ok() { echo "ok   $*"; }
    _warn() { echo "warn $*"; warnings=$((warnings + 1)); }
    _fail() { echo "fail $*"; failures=$((failures + 1)); }

    [ -n "$client" ] && _validate_client_name "$client"

    echo "workstation doctor"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    [ -n "$client" ] && echo "  client:      $client"
    echo ""

    echo "== Reachability =="
    if ! _ssh_quiet "echo ok" >/dev/null; then
        _fail "ssh unreachable at $WORKSTATION_HOSTNAME"
        echo ""
        echo "workstation doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi
    _ok "ssh reachable"

    local remote_identity
    remote_identity=$(_ssh_data "printf '%s %s %s\n' \"\$(hostname)\" \"\$(uname -s)\" \"\$(uname -m)\"" 2>/dev/null || true)
    [ -n "$remote_identity" ] && _ok "$remote_identity"

    local shell_output
    shell_output=$(_ssh_data "zsh -lic 'true' 2>&1" || true)
    if [ -n "$shell_output" ]; then
        _warn "interactive zsh emits output during startup"
        printf '%s\n' "${shell_output//$'\n'/$'\n'     }" | sed '1s/^/     /'
    else
        _ok "interactive zsh starts cleanly"
    fi
    if _ssh_quiet "id -nG '$WORKSTATION_ADMIN_USER' | tr ' ' '\n' | grep -qx sudo"; then
        _ok "admin user is in sudo group"
    else
        _warn "admin user is not in sudo group"
    fi
    if _ssh_quiet "sudo -n true"; then
        _ok "passwordless sudo available for non-interactive privileged checks"
        admin_sudo=1
    else
        echo "info passwordless sudo unavailable; privileged checks will be limited"
    fi

    local admin_home
    admin_home=$(_ssh_quiet "getent passwd '$WORKSTATION_ADMIN_USER' | cut -d: -f6" || true)
    [ -z "$admin_home" ] && admin_home="/home/$WORKSTATION_ADMIN_USER"

    echo ""
    echo "== Core commands =="
    for cmd in git zsh tmux nvim age jq rg curl ssh; do
        if _ssh_quiet "command -v '$cmd' >/dev/null"; then
            _ok "$cmd"
        else
            _fail "missing command: $cmd"
        fi
    done
    for cmd in docker tailscale fastfetch shellcheck; do
        if _ssh_quiet "command -v '$cmd' >/dev/null"; then
            _ok "$cmd"
        else
            _warn "optional command missing: $cmd"
        fi
    done

    if _ssh_quiet "command -v fnm >/dev/null"; then
        if _ssh_quiet "fnm --version >/dev/null"; then
            _ok "fnm usable"
        else
            _warn "fnm exists but cannot run; reinstall it for this CPU architecture"
        fi
    fi

    echo ""
    echo "== Services =="
    if _ssh_quiet "systemctl is-active --quiet tailscaled"; then
        _ok "tailscaled active"
    else
        _fail "tailscaled not active"
    fi
    if _ssh_quiet "systemctl is-enabled --quiet tailscaled"; then
        _ok "tailscaled enabled"
    else
        _warn "tailscaled not enabled"
    fi
    if _ssh_quiet "systemctl is-active --quiet sshd || systemctl is-active --quiet ssh"; then
        _ok "ssh service active"
    else
        _fail "ssh service not active"
    fi
    if _ssh_quiet "systemctl is-enabled --quiet sshd || systemctl is-enabled --quiet ssh"; then
        _ok "ssh service enabled"
    else
        _warn "ssh service not enabled"
    fi
    if _ssh_quiet "command -v docker >/dev/null"; then
        if _ssh_quiet "systemctl is-active --quiet docker"; then
            _ok "docker active"
        else
            _warn "docker not active"
        fi
    fi

    echo ""
    echo "== Resources =="
    local metrics
    metrics=$(_ssh_data 'bash -s' <<'REMOTE'
ram_pct=$(free | awk '/Mem/{printf "%.0f", $3/$2*100}')
ram_used=$(free -h | awk '/Mem/{print $3}')
ram_total=$(free -h | awk '/Mem/{print $2}')
disk_pct=$(df / | awk 'NR==2{gsub(/%/,""); print $5}')
load=$(awk '{print $1}' /proc/loadavg)
temp_file=$(find /sys/class/thermal /sys/class/hwmon /sys/devices \( -name temp -o -name 'temp*_input' \) -type f 2>/dev/null | head -1)
temp_c=""
if [ -n "$temp_file" ]; then
    temp_raw=$(cat "$temp_file" 2>/dev/null || echo "")
    [ -n "$temp_raw" ] && temp_c=$((temp_raw / 1000))
elif command -v sensors >/dev/null 2>&1; then
    temp_c=$(sensors -u 2>/dev/null | awk -F: '/temp[0-9]+_input:/ {gsub(/^[ \t]+/, "", $2); printf "%.0f\n", $2; exit}')
fi
printf 'ram_pct=%s ram=%s/%s disk_pct=%s load=%s temp_c=%s\n' "$ram_pct" "$ram_used" "$ram_total" "$disk_pct" "$load" "$temp_c"
REMOTE
)
    echo "     $metrics"
    local ram_pct ram disk_pct temp_c
    ram_pct=$(echo "$metrics" | awk '{for(i=1;i<=NF;i++) if($i ~ /^ram_pct=/){sub("ram_pct=","",$i); print $i}}')
    ram=$(echo "$metrics" | awk '{for(i=1;i<=NF;i++) if($i ~ /^ram=/){sub("ram=","",$i); print $i}}')
    disk_pct=$(echo "$metrics" | awk '{for(i=1;i<=NF;i++) if($i ~ /^disk_pct=/){sub("disk_pct=","",$i); print $i}}')
    temp_c=$(echo "$metrics" | awk '{for(i=1;i<=NF;i++) if($i ~ /^temp_c=/){sub("temp_c=","",$i); print $i}}')
    if [ "${ram_pct:-0}" -lt 90 ] 2>/dev/null; then
        _ok "memory below 90% (${ram:-unknown})"
    else
        _warn "memory high: ${ram_pct:-unknown}% (${ram:-unknown})"
    fi
    if [ "${disk_pct:-0}" -lt 85 ] 2>/dev/null; then
        _ok "root disk below 85%"
    else
        _warn "root disk high: ${disk_pct:-unknown}%"
    fi
    if [ -n "${temp_c:-}" ]; then
        if [ "$temp_c" -lt 80 ] 2>/dev/null; then
            _ok "temperature below 80C"
        else
            _warn "temperature high: ${temp_c}C"
        fi
    elif _ssh_quiet "command -v sensors >/dev/null"; then
        _warn "temperature sensor unavailable through sysfs"
    else
        _warn "temperature sensor unavailable; install lm-sensors and run sensors-detect"
    fi

    echo ""
    echo "== Dotfiles =="
    if _ssh_quiet "test -d '$admin_home/.dotfiles' && test -x '$admin_home/.dotfiles/install'"; then
        _ok "admin dotfiles install present"
    else
        _fail "admin dotfiles install missing"
    fi
    if _ssh_quiet "test -L '$admin_home/.zshrc'"; then
        _ok "admin .zshrc symlinked"
    else
        _warn "admin .zshrc is not a symlink"
    fi
    if _ssh_quiet "test -x '$admin_home/.local/bin/work'"; then
        _ok "work CLI installed"
    else
        _warn "work CLI missing from admin .local/bin"
    fi
    if _ssh_quiet "test -x '$admin_home/.local/bin/workstation'"; then
        _ok "workstation CLI installed"
    else
        _warn "workstation CLI missing from admin .local/bin"
    fi

    if _ssh_quiet "command -v crontab >/dev/null"; then
        if _ssh_quiet "crontab -l 2>/dev/null | grep -qF 'work-tracker pulse'"; then
            _ok "work-tracker pulse cron installed"
        else
            _warn "work-tracker pulse cron missing"
        fi
        if _ssh_quiet "crontab -l 2>/dev/null | grep -qF 'work-tracker monthly-save'"; then
            _ok "work-tracker monthly-save cron installed"
        else
            _warn "work-tracker monthly-save cron missing"
        fi
    fi

    echo ""
    echo "== Clients =="
    local clients
    clients=$(_list_clients || true)
    if [ -n "$clients" ]; then
        printf '%s\n' "${clients//$'\n'/$'\n'     }" | sed '1s/^/     /'
    else
        _warn "no client users found"
    fi

    if [ -n "$client" ]; then
        echo ""
        echo "== Client: $client =="
        if ! _ssh_quiet "id '$client' >/dev/null 2>&1"; then
            _fail "client user does not exist"
        else
            _ok "client user exists"
            local home_mode client_shell
            home_mode=$(_ssh_quiet "stat -c %a /home/$client 2>/dev/null" || true)
            client_shell=$(_ssh_quiet "getent passwd '$client' | cut -d: -f7" || true)
            if [ "$home_mode" = "700" ]; then
                _ok "home mode is 700"
            else
                _warn "home mode is ${home_mode:-unknown}, expected 700"
            fi
            if [ "$client_shell" = "/bin/zsh" ] || [ "$client_shell" = "/usr/bin/zsh" ]; then
                _ok "login shell is zsh"
            else
                _warn "login shell is ${client_shell:-unknown}"
            fi
            if [ "$admin_sudo" -eq 1 ]; then
                if _ssh_quiet "sudo -n test -d /home/$client/.dotfiles"; then
                    _ok "client dotfiles present"
                else
                    _warn "client dotfiles missing"
                fi
                if _ssh_quiet "sudo -n test -f /home/$client/.clientrc"; then
                    _ok "client .clientrc present"
                    local clientrc_meta
                    clientrc_meta=$(_ssh_quiet "sudo -n stat -c '%U:%G %a' /home/$client/.clientrc" || true)
                    if [ "$clientrc_meta" = "$client:$client 600" ]; then
                        _ok "client .clientrc owner/mode sane"
                    else
                        _warn "client .clientrc owner/mode is ${clientrc_meta:-unknown}, expected $client:$client 600"
                    fi
                else
                    _warn "client .clientrc missing"
                fi
                if _ssh_quiet "sudo -n test -x /home/$client/.local/bin/work-tracker"; then
                    _ok "client work-tracker installed"
                else
                    _warn "client work-tracker missing"
                fi
                if _ssh_quiet "sudo -n -u '$client' crontab -l 2>/dev/null | grep -qF 'work-tracker pulse'"; then
                    _ok "client work-tracker pulse cron installed"
                else
                    _warn "client work-tracker pulse cron missing"
                fi
                if _ssh_quiet "sudo -n -u '$client' crontab -l 2>/dev/null | grep -qF 'work-tracker monthly-save'"; then
                    _ok "client work-tracker monthly-save cron installed"
                else
                    _warn "client work-tracker monthly-save cron missing"
                fi
                if _ssh_quiet "sudo -n -u '$client' /home/$client/.local/bin/work-tracker status >/dev/null"; then
                    _ok "client work-tracker status runs"
                else
                    _warn "client work-tracker status failed"
                fi
            else
                echo "info skipping client dotfile checks because passwordless sudo is unavailable"
            fi
            if _ssh_quiet "id -nG '$client' | tr ' ' '\n' | grep -qx docker"; then
                _warn "client is in docker group (privileged host access)"
            else
                _ok "client not in docker group"
            fi
        fi
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "workstation doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "workstation doctor passed: $warnings warning(s)"
}

# --- status ---
cmd_status() {
    if ! _ssh_quiet "echo ok" >/dev/null; then
        echo "Workstation is offline or unreachable at $WORKSTATION_HOSTNAME"
        exit 1
    fi

    if _ssh_quiet "command -v fastfetch" >/dev/null; then
        _ssh_data "fastfetch"
    else
        _ssh_data 'bash -s' <<'REMOTE'
            echo "=== Workstation Status (install fastfetch: sudo apt install fastfetch) ==="
            echo ""
            echo "Host:    $(hostname)"
            echo "Uptime:  $(uptime -p 2>/dev/null || uptime | sed 's/.*up //')"
            free -h | awk '/^Mem/{printf "Memory:  %s / %s\n", $3, $2}'
            df -h / | awk 'NR==2{printf "Disk:    %s / %s (%s)\n", $3, $2, $5}'
            echo ""
            echo "Docker:  $(docker ps --format '{{.Names}}' 2>/dev/null | paste -sd ', ' || echo none)"
            echo "VPN:     $(sudo -n wg show 2>/dev/null | awk '/^interface:/{printf "%s ", $2}' || echo none)"
            echo "Clients: $(getent passwd | awk -F: '$3>=1000 && $1!="nobody" {print $1}' | paste -sd ', ')"
REMOTE
    fi
