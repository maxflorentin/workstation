    if [ -z "$client" ]; then
        echo "Usage: work vpn-up <client-name>"
        echo "Legacy WireGuard command. Prefer: work tailscale-setup <client>"
        exit 1
    fi

    _validate_client_name "$client"

    if ! _ssh_quiet "sudo -n true"; then
