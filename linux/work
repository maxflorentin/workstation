        echo "preferred: work tailscale-setup $client" >&2
        echo "run legacy: ssh $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME 'sudo wg-quick up -- $client'" >&2
        exit 1
    fi

    local allowed
    allowed=$(_ssh_quiet "sudo -n grep -i 'AllowedIPs' /etc/wireguard/$client.conf 2>/dev/null")
    if echo "$allowed" | grep -q '0\.0\.0\.0/0'; then
        echo "WARNING: $client.conf routes ALL traffic (AllowedIPs = 0.0.0.0/0)"
        echo "This will kill your SSH connection to the workstation."
