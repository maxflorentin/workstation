#!/bin/bash

# work: Manage freelance workspaces on a headless Linux workstation (multi-user model)
# Usage: work <command> [args]
#
# Architecture:
#   - One Linux user per client (e.g. /home/<client>)
#   - Admin user (max) owns /etc, shared VPN configs, compliance tooling
#   - Each client user has their own dotfiles clone, venv, envy, work-tracker log
#   - This CLI runs on Mac and SSHes as the appropriate user per command

set -e

DEFAULT_DOTFILES_REPO="https://github.com/maxflorentin/workstation.git"
WORKSTATION_HOSTNAME="${WORKSTATION_HOST:-${WORK_PI_HOST:-workstation}}"
WORKSTATION_ADMIN_USER="${WORKSTATION_USER:-${WORK_PI_USER:-max}}"
DOTFILES_REPO="${WORKSTATION_DOTFILES_REPO:-${WORK_DOTFILES_REPO:-$DEFAULT_DOTFILES_REPO}}"

_is_local_workstation() {
    [ "$(uname -s)" = "Linux" ] || return 1

    local host_short host_full
    host_short="$(hostname -s 2>/dev/null || hostname)"
    host_full="$(hostname 2>/dev/null || true)"

    [ "$WORKSTATION_HOSTNAME" = "localhost" ] || [ "$WORKSTATION_HOSTNAME" = "127.0.0.1" ] || \
    [ "$WORKSTATION_HOSTNAME" = "$host_short" ] || [ "$WORKSTATION_HOSTNAME" = "$host_full" ]
}

_validate_client_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-z][a-z0-9_-]*$ ]]; then
        echo "Error: client name must be lowercase (Linux username rules: a-z0-9_-, starting with a letter)"
        exit 1
    fi
}

_restore_local_terminal() {
    local tty_state="${1:-}"

    if [ -t 0 ]; then
        if [ -n "$tty_state" ]; then
            stty "$tty_state" 2>/dev/null || stty sane 2>/dev/null || true
        else
            stty sane 2>/dev/null || true
        fi
    fi

    # SSH/tmux can die before restoring these terminal modes, leaving arrow keys
    # and other input as visible escape sequences in the local prompt.
    if [ -t 1 ]; then
        printf '\033[?1l\033>\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[0m' || true
    fi
}

_run_interactive_ssh() {
    local tty_state status
    tty_state="$(stty -g 2>/dev/null || true)"
    status=0

    ssh "$@" || status=$?
    _restore_local_terminal "$tty_state"
    return "$status"
}

# --- Admin SSH helpers (run as $WORKSTATION_ADMIN_USER, typically "max") ---
_ssh() {
    if _is_local_workstation; then
        bash -lc "$*"
    else
        _run_interactive_ssh -t "$WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME" "$@"
    fi
}

_ssh_tty() {
    if _is_local_workstation; then
        bash -lc "$*"
    else
        _run_interactive_ssh -tt "$WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME" "$@"
    fi
}

_ssh_quiet() {
    if _is_local_workstation; then
        bash -lc "$*" 2>/dev/null
    else
        ssh -o BatchMode=yes -o NumberOfPasswordPrompts=0 -o ConnectTimeout=3 "$WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME" "$@" 2>/dev/null
    fi
}

_ssh_data() {
    if _is_local_workstation; then
        bash -lc "$*"
    else
        ssh -T -o ClearAllForwardings=yes "$WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME" "$@"
    fi
}

# --- Client SSH helpers (run as <client>@<workstation>) ---
_run_as_local_client() {
    local u="$1"
    shift

    if [ "$(id -u)" -eq 0 ]; then
        runuser -u "$u" -- env HOME="/home/$u" bash -lc "$*"
    elif sudo -n true >/dev/null 2>&1; then
        sudo -n -u "$u" -H bash -lc "$*"
    else
        sudo -u "$u" -H bash -lc "$*"
    fi
}

_ssh_as() {
    local u="$1"
    shift
    if _is_local_workstation; then
        _run_as_local_client "$u" "$@"
    else
        _run_interactive_ssh -t "$u@$WORKSTATION_HOSTNAME" "$@"
    fi
}

_ssh_as_tty() {
    local u="$1"
    shift
    if _is_local_workstation; then
        _run_as_local_client "$u" "$@"
    else
        _run_interactive_ssh -tt "$u@$WORKSTATION_HOSTNAME" "$@"
    fi
}

_ssh_as_quiet() {
    local u="$1"
    shift
    if _is_local_workstation; then
        _run_as_local_client "$u" "$@" 2>/dev/null
    else
        ssh -o BatchMode=yes -o NumberOfPasswordPrompts=0 -o ConnectTimeout=3 "$u@$WORKSTATION_HOSTNAME" "$@" 2>/dev/null
    fi
}

_ssh_as_data() {
    local u="$1"
    shift
    if _is_local_workstation; then
        _run_as_local_client "$u" "$@"
    else
        ssh -T -o ClearAllForwardings=yes "$u@$WORKSTATION_HOSTNAME" "$@"
    fi
}

# List client users on the workstation (real humans with /home and a login shell,
# excluding the admin user and known system helpers like ecryptfs's encryption_user).
_list_clients() {
    _ssh_quiet "getent passwd | awk -F: '\$3>=1000 && \$1!=\"$WORKSTATION_ADMIN_USER\" && \$1!=\"nobody\" && \$1!=\"encryption_user\" && \$7 !~ /(nologin|false)\$/ && \$6 ~ /^\\/home\\// {print \$1}'"
}

_truthy() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        *) return 1 ;;
    esac
}

_sh_quote() {
    printf '%q' "$1"
}

_tracker_local_event() {
    local event="$1" client="$2" project="$3"
    command -v work-tracker >/dev/null 2>&1 || return 0
    work-tracker "$event" "$client" "$project" "${WORK_TRACKER_SOURCE:-mac}" 2>/dev/null || true
}

# --- connect ---
cmd_connect() {
    local browse=0
    local client=""
    local project=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --browse)
                browse=1
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "Usage: work connect [--browse] [client] [project]"
                exit 1
                ;;
            *)
                if [ -z "$client" ]; then
                    client="$1"
                elif [ -z "$project" ]; then
                    project="$1"
                else
                    echo "Usage: work connect [--browse] [client] [project]"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    if [ $# -gt 0 ]; then
        if [ -z "$client" ]; then
            client="$1"
            shift
        fi
        if [ $# -gt 0 ] && [ -z "$project" ]; then
            project="$1"
            shift
        fi
    fi

    if [ $# -gt 0 ]; then
        echo "Usage: work connect [--browse] [client] [project]"
        exit 1
    fi

    if [ -z "$client" ]; then
        if [ "$browse" -eq 1 ]; then
            echo "Usage: work connect [--browse] <client> [project]"
            exit 1
        fi
        # No client → connect as admin to a plain tmux session
        _ssh_tty "tmux attach 2>/dev/null || tmux new -s main"
        return
    fi

    _validate_client_name "$client"

    # Mount ecryptfs home if encrypted and not already mounted.
    # Passphrase stored in /etc/ecryptfs/<client>.passphrase (root-only, 600).
    # See: docs/ecryptfs.md
    _ssh_quiet "sudo /usr/local/sbin/ecryptfs-auto-mount '$client'" || true

    if [ "$browse" -eq 1 ]; then
        cmd_browse "$client"
    fi

    _tracker_local_event start "$client" "$project"

    local q_client q_project q_source layout_cmd remote_cmd
    q_client="$(_sh_quote "$client")"
    q_project="$(_sh_quote "$project")"
    q_source="$(_sh_quote "${WORK_TRACKER_SOURCE:-work-connect}")"
    layout_cmd="/home/$client/.dotfiles/linux/tmux-layout"
    if [ -n "$project" ]; then
        layout_cmd="$layout_cmd $q_project"
    fi
    remote_cmd="
        tracker_dir=\"\$HOME/.local/share/work-tracker\"
        tracker_log=\"\$tracker_dir/log.tsv\"
        mkdir -p \"\$tracker_dir\"
        [ -f \"\$tracker_log\" ] || printf 'timestamp\tevent\tclient\tproject\tsource\n' > \"\$tracker_log\"

        if [ ! -x \"\$HOME/.local/bin/work-tracker\" ] && [ -x \"\$HOME/.dotfiles/install\" ]; then
            (cd \"\$HOME/.dotfiles\" && ./install >/dev/null 2>&1) || true
        fi

        tracker_fallback_event() {
            event=\"\$1\"
            clean_client=\"\$(printf '%s' \"\$2\" | tr '\t\r\n' '   ')\"
            clean_project=\"\$(printf '%s' \"\$3\" | tr '\t\r\n' '   ')\"
            clean_source=\"\$(printf '%s' \"\$4\" | tr '\t\r\n' '   ')\"
            printf '%s\t%s\t%s\t%s\t%s\n' \"\$(date +%s)\" \"\$event\" \"\$clean_client\" \"\$clean_project\" \"\$clean_source\" >> \"\$tracker_log\"
        }

        tracker_event() {
            event=\"\$1\"
            if [ -x \"\$HOME/.local/bin/work-tracker\" ]; then
                WORK_TRACKER_SOURCE=$q_source \"\$HOME/.local/bin/work-tracker\" \"\$event\" $q_client $q_project $q_source || true
            else
                tracker_fallback_event \"\$event\" $q_client $q_project $q_source
            fi
        }

        tracker_event start
        if [ -x \"\$HOME/.local/bin/work-tracker\" ]; then
            WORK_TRACKER_SOURCE=$q_source \"\$HOME/.local/bin/work-tracker\" pulse || true
        fi
        $layout_cmd
        rc=\$?
        if [ -x \"\$HOME/.local/bin/work-tracker\" ]; then
            WORK_TRACKER_SOURCE=$q_source \"\$HOME/.local/bin/work-tracker\" pulse || true
        fi
        tracker_event stop
        exit \$rc
    "

    local rc
    set +e
    _ssh_as_tty "$client" "$remote_cmd"
    rc=$?
    set -e

    _tracker_local_event stop "$client" "$project"
    return "$rc"
}

# --- user-create ---
# Creates a dedicated Linux user for the client on the workstation
cmd_user_create() {
    local client="$1"
    if [ -z "$client" ]; then
        echo "Usage: work user-create <client>"
        echo ""
        echo "Creates a dedicated Linux user on the workstation with:"
        echo "  - Home at /home/<client> (mode 700)"
        echo "  - Dotfiles clone + install"
        echo "  - SSH authorized_keys seeded from admin's"
        echo "  - Envy context, .clientrc from template, Python venv via uv"
        exit 1
    fi

    _validate_client_name "$client"
    echo "Creating user '$client' on workstation..."
    echo ""

    # Phase 1: admin-side ops (useradd, SSH keys, dotfiles clone + install)
    _ssh_data "DOTFILES_REPO='$DOTFILES_REPO' WORKSTATION_ADMIN_USER='$WORKSTATION_ADMIN_USER' CLIENT='$client' WORK_CLIENT_DOCKER='${WORK_CLIENT_DOCKER:-0}' bash -s" <<'REMOTE'
set -e

SUDO=""
if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
elif sudo -n true >/dev/null 2>&1; then
    SUDO="sudo -n"
else
    echo "user-create requires sudo on the workstation" >&2
    echo "run: ssh $WORKSTATION_ADMIN_USER@$(hostname -s) 'sudo ~/.local/bin/work user-create $CLIENT'" >&2
    exit 1
fi

run_root() {
    if [ -n "$SUDO" ]; then
        $SUDO "$@"
    else
        "$@"
    fi
}

run_as_client() {
    if [ -n "$SUDO" ]; then
        $SUDO -u "$CLIENT" "$@"
    else
        runuser -u "$CLIENT" -- "$@"
    fi
}

run_as_client_home() {
    if [ -n "$SUDO" ]; then
        $SUDO -u "$CLIENT" -H "$@"
    else
        runuser -u "$CLIENT" -- env HOME="/home/$CLIENT" "$@"
    fi
}

if id "$CLIENT" &>/dev/null; then
    echo "  user $CLIENT already exists (skipping useradd)"
else
    run_root useradd -m -s /bin/zsh "$CLIENT"
    run_root chmod 700 "/home/$CLIENT"
    echo "  user $CLIENT created (home: /home/$CLIENT)"
fi

# Optional: share the Docker daemon with the client. This is privileged host
# access, so it is opt-in.
if [ "${WORK_CLIENT_DOCKER:-0}" = "1" ] && getent group docker >/dev/null 2>&1; then
    run_root usermod -aG docker "$CLIENT"
    echo "  user $CLIENT added to docker group"
fi

# Seed SSH authorized_keys (ecryptfs-compatible path used by sshd_config)
run_root mkdir -p /etc/ssh/authorized_keys
if ! run_root test -f "/etc/ssh/authorized_keys/$CLIENT"; then
    if run_root test -f "/etc/ssh/authorized_keys/$WORKSTATION_ADMIN_USER"; then
        run_root cp "/etc/ssh/authorized_keys/$WORKSTATION_ADMIN_USER" "/etc/ssh/authorized_keys/$CLIENT"
    elif [ -f "/home/$WORKSTATION_ADMIN_USER/.ssh/authorized_keys" ]; then
        run_root cp "/home/$WORKSTATION_ADMIN_USER/.ssh/authorized_keys" "/etc/ssh/authorized_keys/$CLIENT"
    fi
    run_root chmod 644 "/etc/ssh/authorized_keys/$CLIENT"
    run_root chown root:root "/etc/ssh/authorized_keys/$CLIENT"
    echo "  authorized_keys seeded from $WORKSTATION_ADMIN_USER"
fi

# Clone dotfiles as the client user.
# If the dir exists but is missing `install` (stale/partial clone), nuke and re-clone.
if run_root test -d "/home/$CLIENT/.dotfiles" && ! run_root test -f "/home/$CLIENT/.dotfiles/install"; then
    echo "  removing stale dotfiles clone (missing ./install)"
    run_root rm -rf "/home/$CLIENT/.dotfiles"
fi
if ! run_root test -d "/home/$CLIENT/.dotfiles"; then
    run_as_client git clone "$DOTFILES_REPO" "/home/$CLIENT/.dotfiles"
    echo "  dotfiles cloned from $DOTFILES_REPO"
fi

# Run install as the client user (symlinks zshrc, tmux conf, fastfetch, crons, etc.)
# Use -H so HOME is set to /home/$CLIENT; use absolute paths to avoid ~ expansion issues.
run_as_client_home bash -lc "cd /home/$CLIENT/.dotfiles && bash ./install" || true

echo ""
echo "Phase 2: seeding envy and venv (as $CLIENT)..."
echo ""

run_as_client_home bash -lc '
set -e

# Install uv if not already present for this user
if [ ! -x ~/.local/bin/uv ]; then
    curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null 2>&1 || true
fi

# Envy init + per-client context
[ -d ~/.envy ] || ~/.local/bin/envy-init 2>/dev/null || true
[ -f ~/.envy/keys/$USER.key ] || ~/.local/bin/envy-new $USER 2>/dev/null || true

# Python venv
if [ ! -d ~/.venv ] && [ -x ~/.local/bin/uv ]; then
    ~/.local/bin/uv venv ~/.venv >/dev/null 2>&1 && echo "  venv created at ~/.venv"
fi

mkdir -p ~/.kube
'
REMOTE

    cmd_clientrc_init "$client"

    echo ""
    echo "User '$client' ready."
    echo ""
    echo "Connect with:           work connect $client"
    echo "Generate SSH key:       work ssh-keygen $client"
    echo "Encrypt home (compliance): ssh $client@$WORKSTATION_HOSTNAME sudo ecryptfs-migrate-home -u $client"
}

# --- clientrc-init ---
# Installs the sanitized clientrc template into a client user's home.
cmd_clientrc_init() {
    local client="${1:-}"
    local force=0

    if [ "$client" = "--force" ]; then
        force=1
        client="${2:-}"
    elif [ "${2:-}" = "--force" ]; then
        force=1
    fi

    if [ -z "$client" ]; then
        echo "Usage: work clientrc-init [--force] <client>"
        echo "Copies templates/clientrc.example to /home/<client>/.clientrc on the workstation."
        exit 1
    fi

    _validate_client_name "$client"

    _ssh_data "CLIENT='$client' FORCE='$force' WORKSTATION_ADMIN_USER='$WORKSTATION_ADMIN_USER' bash -s" <<'REMOTE'
set -e

SUDO=""
if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
elif sudo -n true >/dev/null 2>&1; then
    SUDO="sudo -n"
else
    echo "clientrc-init requires sudo on the workstation" >&2
    echo "run: ssh $WORKSTATION_ADMIN_USER@$(hostname -s) 'sudo ~/.local/bin/work clientrc-init $CLIENT'" >&2
    exit 1
fi

run_root() {
    if [ -n "$SUDO" ]; then
        $SUDO "$@"
    else
        "$@"
    fi
}

if ! id "$CLIENT" >/dev/null 2>&1; then
    echo "client user does not exist: $CLIENT" >&2
    exit 1
fi

dest="/home/$CLIENT/.clientrc"
if run_root test -f "$dest" && [ "$FORCE" != "1" ]; then
    echo "  .clientrc already exists (use --force to replace)"
    exit 0
fi

template=""
for candidate in \
    "/home/$WORKSTATION_ADMIN_USER/.dotfiles/templates/clientrc.example" \
    "/home/$CLIENT/.dotfiles/templates/clientrc.example"
do
    if run_root test -f "$candidate"; then
        template="$candidate"
        break
    fi
done

if [ -z "$template" ]; then
    echo "clientrc template not found" >&2
    exit 1
fi

tmp_src="$(mktemp)"
tmp_out="$(mktemp)"
cleanup_clientrc_init() {
    rm -f "$tmp_src" "$tmp_out"
}
trap cleanup_clientrc_init EXIT

if ! run_root cat "$template" > "$tmp_src"; then
    echo "clientrc template unreadable: $template" >&2
    exit 1
fi

sed "s/<client>/$CLIENT/g" "$tmp_src" > "$tmp_out"
run_root install -o "$CLIENT" -g "$CLIENT" -m 600 "$tmp_out" "$dest"
echo "  .clientrc installed from template"
REMOTE
}

# --- clientrc-doctor ---
# Validates client-local .clientrc without printing values.
cmd_clientrc_doctor() {
    local client="${1:-}"
    local failures=0
    local warnings=0

    _ok() { echo "ok   $*"; }
    _warn() { echo "warn $*"; warnings=$((warnings + 1)); }
    _fail() { echo "fail $*"; failures=$((failures + 1)); }

    if [ -z "$client" ]; then
        echo "Usage: work clientrc-doctor <client>"
        exit 1
    fi

    _validate_client_name "$client"

    echo "clientrc doctor"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    echo "  client:      $client"
    echo ""

    local result
    result=$(_ssh_data "CLIENT='$client' bash -s" <<'REMOTE'
set -e

path="/home/$CLIENT/.clientrc"
SUDO=""
if sudo -n true >/dev/null 2>&1; then
    SUDO="sudo -n"
fi

if ! id "$CLIENT" >/dev/null 2>&1; then
    echo "FAIL client user does not exist"
    exit 0
fi
echo "OK client user exists"

if [ -n "$SUDO" ]; then
    if ! $SUDO test -f "$path"; then
        echo "FAIL .clientrc missing"
        exit 0
    fi
else
    if [ ! -r "$path" ]; then
        echo "WARN privileged checks limited; run on workstation with sudo for full .clientrc validation"
        exit 0
    fi
fi
echo "OK .clientrc exists"

if [ -n "$SUDO" ]; then
    owner="$($SUDO stat -c '%U:%G' "$path" 2>/dev/null || true)"
    mode="$($SUDO stat -c '%a' "$path" 2>/dev/null || true)"
else
    owner="$(stat -c '%U:%G' "$path" 2>/dev/null || true)"
    mode="$(stat -c '%a' "$path" 2>/dev/null || true)"
fi

if [ "$owner" = "$CLIENT:$CLIENT" ]; then
    echo "OK .clientrc owner is client"
else
    echo "FAIL .clientrc owner is ${owner:-unknown}, expected $CLIENT:$CLIENT"
fi

if [ "$mode" = "600" ]; then
    echo "OK .clientrc mode is 600"
else
    echo "WARN .clientrc mode is ${mode:-unknown}, expected 600"
fi

tmp=""
if [ -n "$SUDO" ]; then
    tmp="$(mktemp)"
    if ! $SUDO cat "$path" > "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        echo "WARN .clientrc unreadable for key validation"
        exit 0
    fi
else
    tmp="$path"
fi

for key in WORK_CLIENT_LABEL WORK_CONNECT_BROWSE WORK_CLIENT_TAILSCALE_ENABLED WORK_CLIENT_COMPLIANCE_PROFILE; do
    if grep -Eq "^[[:space:]]*(export[[:space:]]+)?$key=" "$tmp"; then
        echo "OK key present: $key"
    else
        echo "WARN key missing: $key"
    fi
done

if grep -q '<client>' "$tmp"; then
    echo "WARN placeholder remains in .clientrc"
else
    echo "OK no <client> placeholder remains"
fi

[ "$tmp" = "$path" ] || rm -f "$tmp"
REMOTE
)

    while IFS= read -r line; do
        case "$line" in
            OK\ *) _ok "${line#OK }" ;;
            WARN\ *) _warn "${line#WARN }" ;;
            FAIL\ *) _fail "${line#FAIL }" ;;
            *) [ -n "$line" ] && echo "info $line" ;;
        esac
    done <<< "$result"

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "clientrc doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "clientrc doctor passed: $warnings warning(s)"
}

# --- client-profile ---
# Prints a sanitized decision summary for one client.
cmd_client_profile() {
    local client="${1:-}"

    if [ -z "$client" ]; then
        echo "Usage: work client-profile <client>"
        echo "Prints sanitized client decisions from .clientrc and host state."
        exit 1
    fi

    _validate_client_name "$client"

    echo "client profile"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    echo "  client:      $client"
    echo ""

    _ssh_data "CLIENT='$client' WORKSTATION_ADMIN_USER='$WORKSTATION_ADMIN_USER' bash -s" <<'REMOTE'
set -e

path="/home/$CLIENT/.clientrc"
SUDO=""
if sudo -n true >/dev/null 2>&1; then
    SUDO="sudo -n"
fi

state() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|on|ON) echo "enabled" ;;
        0|false|FALSE|no|NO|off|OFF|"") echo "disabled" ;;
        *) echo "custom" ;;
    esac
}

read_key() {
    local key="$1"
    local read_path="${CLIENTRC_READ_PATH:-$path}"
    [ -f "$read_path" ] || return 0
    awk -F= -v key="$key" '
        $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "=" {
            value=$0
            sub("^[[:space:]]*(export[[:space:]]+)?" key "=", "", value)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            gsub(/^["'\''"]|["'\''"]$/, "", value)
            print value
            exit
        }
    ' "$read_path"
}

if ! id "$CLIENT" >/dev/null 2>&1; then
    echo "user: missing"
    exit 0
fi

echo "user: present"

tmp=""
if [ -n "$SUDO" ]; then
    if $SUDO test -f "$path"; then
        echo "clientrc: present"
        tmp="$(mktemp)"
        if ! $SUDO cat "$path" > "$tmp" 2>/dev/null; then
            rm -f "$tmp"
            tmp=""
        fi
    else
        echo "clientrc: missing"
    fi
else
    if [ -r "$path" ]; then
        echo "clientrc: present"
        tmp="$path"
    else
        echo "clientrc: unknown"
        echo "scope: limited"
    fi
fi

if id -nG "$CLIENT" | tr ' ' '\n' | grep -qx docker; then
    echo "docker: enabled"
else
    echo "docker: disabled"
fi

if [ -n "$tmp" ]; then
    CLIENTRC_READ_PATH="$tmp"
    echo "browser_companion: $(state "$(read_key WORK_CONNECT_BROWSE)")"
    echo "secondary_tailscale_declared: $(state "$(read_key WORK_CLIENT_TAILSCALE_ENABLED)")"
    echo "compliance_declared: $(state "$(read_key WORK_CLIENT_COMPLIANCE_PROFILE)")"

    backup_target="$(read_key WORK_CLIENT_CONFIG_BACKUP_TARGET)"
    backup_recipient="$(read_key WORK_CLIENT_CONFIG_BACKUP_RECIPIENT)"
    if [ -n "$backup_target" ] || [ -n "$backup_recipient" ]; then
        echo "config_backup_declared: enabled"
    else
        echo "config_backup_declared: disabled"
    fi
else
    echo "browser_companion: unknown"
    echo "secondary_tailscale_declared: unknown"
    echo "compliance_declared: unknown"
    echo "config_backup_declared: unknown"
fi

if systemctl list-unit-files --no-legend "tailscaled-$CLIENT.service" 2>/dev/null | grep -q .; then
    echo "secondary_tailscale_unit: present"
else
    echo "secondary_tailscale_unit: missing"
fi

if [ -d "/home/$CLIENT/.envy" ]; then
    echo "envy: present"
else
    echo "envy: missing"
fi

if [ -n "$SUDO" ] && { $SUDO test -d "/home/.ecryptfs/$CLIENT" || findmnt -no FSTYPE "/home/$CLIENT" 2>/dev/null | grep -qx ecryptfs; }; then
    echo "encrypted_home: present"
else
    echo "encrypted_home: unknown"
fi

[ -z "$tmp" ] || [ "$tmp" = "$path" ] || rm -f "$tmp"
REMOTE
}

# --- clients ---
# Lists client users with sanitized operational state.
cmd_clients() {
    echo "clients"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    echo ""

    _ssh_data "WORKSTATION_ADMIN_USER='$WORKSTATION_ADMIN_USER' bash -s" <<'REMOTE'
set -e

SUDO=""
if sudo -n true >/dev/null 2>&1; then
    SUDO="sudo -n"
fi

state() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|on|ON) echo "on" ;;
        0|false|FALSE|no|NO|off|OFF|"") echo "off" ;;
        *) echo "custom" ;;
    esac
}

read_key() {
    local path="$1"
    local key="$2"
    [ -f "$path" ] || return 0
    awk -F= -v key="$key" '
        $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "=" {
            value=$0
            sub("^[[:space:]]*(export[[:space:]]+)?" key "=", "", value)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            gsub(/^["'\''"]|["'\''"]$/, "", value)
            print value
            exit
        }
    ' "$path"
}

clients=$(getent passwd | awk -F: -v admin="$WORKSTATION_ADMIN_USER" '$3>=1000 && $1!=admin && $1!="nobody" && $1!="encryption_user" && $7 !~ /(nologin|false)$/ && $6 ~ /^\/home\// {print $1}' | sort)

if [ -z "$clients" ]; then
    echo "(no client users found)"
    exit 0
fi

if [ -z "$SUDO" ]; then
    echo "info privileged checks limited; run on workstation with sudo for full state"
    echo ""
fi

printf '%-18s %-8s %-6s %-8s %-10s %-10s %-10s %-10s\n' \
    "client" "clientrc" "docker" "browser" "tailscale" "compliance" "backup" "encrypted"

while IFS= read -r client; do
    [ -z "$client" ] && continue
    path="/home/$client/.clientrc"

    if [ -n "$SUDO" ]; then
        test_file_cmd="$SUDO test -f '$path'"
    else
        test_file_cmd="test -f '$path'"
    fi

    if bash -lc "$test_file_cmd"; then
        clientrc="yes"
    else
        if [ -z "$SUDO" ]; then
            clientrc="unknown"
        else
            clientrc="no"
        fi
    fi

    if id -nG "$client" | tr ' ' '\n' | grep -qx docker; then
        docker="yes"
    else
        docker="no"
    fi

    if [ -n "$SUDO" ]; then
        tmp="$(mktemp)"
        if $SUDO cat "$path" > "$tmp" 2>/dev/null; then
            browser="$(state "$(read_key "$tmp" WORK_CONNECT_BROWSE)")"
            tailscale="$(state "$(read_key "$tmp" WORK_CLIENT_TAILSCALE_ENABLED)")"
            compliance="$(state "$(read_key "$tmp" WORK_CLIENT_COMPLIANCE_PROFILE)")"
            backup_target="$(read_key "$tmp" WORK_CLIENT_CONFIG_BACKUP_TARGET)"
            backup_recipient="$(read_key "$tmp" WORK_CLIENT_CONFIG_BACKUP_RECIPIENT)"
            if [ -n "$backup_target" ] || [ -n "$backup_recipient" ]; then
                backup="on"
            else
                backup="off"
            fi
        else
            browser="unknown"
            tailscale="unknown"
            compliance="unknown"
            backup="unknown"
        fi
        rm -f "$tmp"
    else
        browser="unknown"
        tailscale="unknown"
        compliance="unknown"
        backup="unknown"
    fi

    if [ -n "$SUDO" ] && { $SUDO test -d "/home/.ecryptfs/$client" || findmnt -no FSTYPE "/home/$client" 2>/dev/null | grep -qx ecryptfs; }; then
        encrypted="yes"
    else
        encrypted="unknown"
    fi

    printf '%-18s %-8s %-6s %-8s %-10s %-10s %-10s %-10s\n' \
        "$client" "$clientrc" "$docker" "$browser" "$tailscale" "$compliance" "$backup" "$encrypted"
done <<< "$clients"
REMOTE
}

