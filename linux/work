ram_pct=$(free | awk '/Mem/{printf "%.0f", $3/$2*100}')
disk_pct=$(df / | awk 'NR==2{gsub(/%/,""); print $5}')
load=$(awk '{print $1}' /proc/loadavg)
temp_file=$(find /sys/class/thermal /sys/class/hwmon /sys/devices \( -name temp -o -name 'temp*_input' \) -type f 2>/dev/null | head -1)
temp_c=""
if [ -n "$temp_file" ]; then
