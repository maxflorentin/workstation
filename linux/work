# --- tailscale-doctor / vpn-doctor ---
# Non-destructive checks for the personal Tailscale daemon and optional
# per-client secondary Tailscale instance on the workstation.
cmd_tailscale_doctor() {
    local client="${1:-}"
    local failures=0
    local warnings=0

    _ok() { echo "ok   $*"; }
    _warn() { echo "warn $*"; warnings=$((warnings + 1)); }
    _fail() { echo "fail $*"; failures=$((failures + 1)); }

    [ -n "$client" ] && _validate_client_name "$client"

    echo "tailscale doctor"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    [ -n "$client" ] && echo "  client:      $client"
    echo ""

    echo "== Local Mac =="
    if command -v tailscale >/dev/null 2>&1; then
        _ok "tailscale command available"
        if tailscale status >/dev/null 2>&1; then
            _ok "personal tailscale status responds"
            if tailscale ip -4 >/dev/null 2>&1; then
                _ok "personal tailscale has IPv4"
            else
                _warn "personal tailscale has no IPv4"
            fi
        else
            _warn "tailscale installed but status failed locally"
        fi
    else
        _warn "tailscale command not installed locally"
    fi

    echo ""
    echo "== Workstation personal =="
    if ! _ssh_quiet "echo ok" >/dev/null; then
        _fail "workstation unreachable at $WORKSTATION_HOSTNAME"
    else
        _ok "ssh reachable"
        local shell_output
        shell_output=$(_ssh_data "zsh -lic 'true' 2>&1" || true)
        if [ -n "$shell_output" ]; then
            _warn "interactive zsh emits output during startup"
            printf '%s\n' "${shell_output//$'\n'/$'\n'     }" | sed '1s/^/     /'
        else
            _ok "interactive zsh starts cleanly"
        fi

        if _ssh_quiet "command -v tailscale >/dev/null"; then
            _ok "tailscale command available"
            if _ssh_quiet "tailscale status >/dev/null"; then
                _ok "personal tailscale status responds"
            else
                _fail "personal tailscale status failed"
            fi
            if _ssh_quiet "tailscale ip -4 >/dev/null"; then
                _ok "personal tailscale has IPv4"
            else
                _warn "personal tailscale has no IPv4"
            fi
            if _ssh_quiet "systemctl is-active --quiet tailscaled"; then
                _ok "tailscaled service active"
            else
                _warn "tailscaled service not active or systemctl unavailable"
            fi
        else
            _fail "tailscale command missing on workstation"
        fi
    fi

    if [ -n "$client" ]; then
        echo ""
        echo "== Workstation secondary: $client =="
        local service="tailscaled-$client"
        local wrapper="/usr/local/bin/tailscale-$client"
        local socket="/run/tailscale-$client.sock"
        local unit="/etc/systemd/system/$service.service"

        if ! _ssh_quiet "id '$client' >/dev/null 2>&1"; then
            _fail "client user does not exist: $client"
        else
            _ok "client user exists"
        fi

        if _ssh_quiet "test -x '$wrapper'"; then
            _ok "wrapper exists: $wrapper"
        else
            _fail "wrapper missing: $wrapper"
        fi
        if _ssh_quiet "test -S '$socket'"; then
            _ok "socket exists: $socket"
        else
            _warn "socket missing: $socket"
        fi
        if _ssh_quiet "systemctl is-active --quiet '$service'"; then
            _ok "service active: $service"
        else
            _warn "service not active: $service"
        fi
        if _ssh_quiet "grep -q -- '--tun=userspace-networking' '$unit'"; then
            _ok "secondary daemon uses userspace networking"
        else
            _fail "secondary daemon is not configured for userspace networking"
        fi
        if _ssh_quiet "grep -q -- '--accept-routes is blocked' '$wrapper'"; then
            _ok "wrapper blocks --accept-routes"
        else
            _fail "wrapper does not appear to block --accept-routes"
        fi
        if _ssh_as_quiet "$client" "tailscale-$client status >/dev/null 2>&1"; then
            _ok "secondary tailscale status responds as client"
        elif _ssh_quiet "sudo -n tailscale --socket='$socket' status >/dev/null 2>&1"; then
            _ok "secondary tailscale status responds via admin sudo"
        else
            _warn "secondary tailscale status failed"
        fi

        if [ "$failures" -gt 0 ]; then
            echo ""
            echo "To install a secondary Tailscale instance:"
            echo "  work tailscale-setup $client"
        fi
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "tailscale doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "tailscale doctor passed: $warnings warning(s)"
}

cmd_tailscale_setup() {
    local client="${1:-}"
    if [ -z "$client" ]; then
        echo "Usage: work tailscale-setup <client>"
        echo ""
        echo "Installs the secondary Tailscale daemon/wrapper for a client user."
        echo "Requires sudo on the workstation."
        exit 1
    fi
    _validate_client_name "$client"

    if _ssh_quiet "sudo -n true"; then
        _ssh_tty "sudo -n ~/.dotfiles/workstation/tailscale-client-setup '$client'"
    else
        echo "tailscale-setup requires sudo on the workstation" >&2
        echo "run: ssh $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME 'sudo ~/.local/bin/work tailscale-setup $client'" >&2
        exit 1
    fi
}

# --- compliance-doctor ---
# Non-destructive checks for an optional per-client compliance profile.
cmd_compliance_doctor() {
    local client="${1:-}"
    local failures=0
    local warnings=0

    _ok() { echo "ok   $*"; }
    _warn() { echo "warn $*"; warnings=$((warnings + 1)); }
    _fail() { echo "fail $*"; failures=$((failures + 1)); }

    if [ -z "$client" ]; then
        echo "Usage: work compliance-doctor <client>"
        echo ""
        echo "Checks optional per-client compliance controls:"
        echo "  endpoint agent, scoped file monitoring, DNS filtering, antivirus, encryption."
        exit 1
    fi
    _validate_client_name "$client"

    echo "compliance doctor"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    echo "  client:      $client"
    echo ""

    echo "== Client =="
    if _ssh_quiet "id '$client' >/dev/null 2>&1"; then
        _ok "client user exists"
    else
        _fail "client user does not exist"
    fi

    echo ""
    echo "== Endpoint Agent =="
    if _ssh_quiet "systemctl is-active --quiet wazuh-agent.service"; then
        _ok "wazuh-agent active"
    else
        _fail "wazuh-agent inactive"
    fi

    local wazuh_dirs
    wazuh_dirs=$(_ssh_quiet "awk '/<syscheck>/,/<\\/syscheck>/' /var/ossec/etc/ossec.conf 2>/dev/null | sed -n 's/.*<directories[^>]*>\\([^<]*\\)<\\/directories>.*/\\1/p'" || true)
    if [ -z "$wazuh_dirs" ]; then
        wazuh_dirs=$(_ssh_quiet "sudo -n awk '/<syscheck>/,/<\\/syscheck>/' /var/ossec/etc/ossec.conf 2>/dev/null | sed -n 's/.*<directories[^>]*>\\([^<]*\\)<\\/directories>.*/\\1/p'" || true)
    fi
    if [ -n "$wazuh_dirs" ]; then
        if echo "$wazuh_dirs" | tr ',' '\n' | awk '{gsub(/^[ \t]+|[ \t]+$/, ""); print}' | grep -qx "/home/$client"; then
            _ok "wazuh syscheck includes /home/$client"
        else
            _fail "wazuh syscheck does not include /home/$client"
        fi

        if echo "$wazuh_dirs" | tr ',' '\n' | awk '{gsub(/^[ \t]+|[ \t]+$/, ""); print}' | grep -Eq '^(/|/home|/home/max|/etc|/usr|/usr/bin|/usr/sbin|/bin|/sbin|/boot)$'; then
            _fail "wazuh syscheck includes global/non-client paths"
        else
            _ok "wazuh syscheck avoids global/non-client paths"
        fi
    else
        _fail "wazuh syscheck scope not verifiable"
        echo "     run on the workstation with sudo: sudo ~/.local/bin/work compliance-doctor $client"
    fi

    echo ""
    echo "== Web Filtering =="
    local resolved_nextdns dnsmasq_nextdns resolved_dot dnsmasq_active resolved_active
    resolved_nextdns=$(_ssh_quiet "grep -c 'dns.nextdns.io' /etc/systemd/resolved.conf 2>/dev/null" || echo 0)
    resolved_dot=$(_ssh_quiet "grep -ci '^DNSOverTLS=yes' /etc/systemd/resolved.conf 2>/dev/null" || echo 0)
    dnsmasq_nextdns=$(_ssh_quiet "grep -R -c -E '(^server=(45\\.90\\.28\\.0|45\\.90\\.30\\.0|2a07:a8c0::|2a07:a8c1::)|^add-cpe-id=)' /etc/dnsmasq.conf /etc/dnsmasq.d 2>/dev/null | awk -F: '{s+=\$2} END{print s+0}'" || echo 0)
    if _ssh_quiet "systemctl is-active --quiet systemd-resolved.service"; then
        resolved_active=1
    else
        resolved_active=0
    fi
    if _ssh_quiet "systemctl is-active --quiet dnsmasq.service"; then
        dnsmasq_active=1
    else
        dnsmasq_active=0
    fi

    if [ "${resolved_nextdns:-0}" -ge 2 ] 2>/dev/null; then
        _ok "systemd-resolved contains NextDNS endpoints ($resolved_nextdns)"
        if [ "$resolved_active" -eq 1 ]; then
            _ok "systemd-resolved active"
        else
            _warn "systemd-resolved not active"
        fi
        if [ "${resolved_dot:-0}" -ge 1 ] 2>/dev/null; then
            _ok "DNS-over-TLS enabled"
        else
            _warn "DNS-over-TLS not enabled"
        fi
    elif [ "${dnsmasq_nextdns:-0}" -ge 3 ] 2>/dev/null; then
        _ok "dnsmasq contains NextDNS configuration"
        if [ "$dnsmasq_active" -eq 1 ]; then
            _ok "dnsmasq active"
        else
            _warn "dnsmasq not active"
        fi
    else
        _fail "NextDNS configuration missing for systemd-resolved or dnsmasq"
    fi

    echo ""
    echo "== Antivirus =="
    for pkg in clamav clamav-daemon clamav-freshclam; do
        if _ssh_quiet "dpkg -s '$pkg' >/dev/null 2>&1"; then
            _ok "package installed: $pkg"
        else
            _fail "package missing: $pkg"
        fi
    done
    if _ssh_quiet "systemctl is-active --quiet clamav-daemon.service"; then
        _ok "clamav-daemon active"
    else
        _fail "clamav-daemon inactive"
    fi
    if _ssh_quiet "systemctl is-active --quiet clamav-freshclam.service"; then
        _ok "clamav-freshclam active"
    else
        _fail "clamav-freshclam inactive"
    fi
    if _ssh_quiet "test -s /var/log/clamav/freshclam.log"; then
        _ok "freshclam log exists"
    else
        _warn "freshclam log missing or empty"
    fi

    echo ""
    echo "== Encryption =="
    local home_fs disk_crypto
    home_fs=$(_ssh_quiet "findmnt -no FSTYPE /home/$client 2>/dev/null" || true)
    disk_crypto=$(_ssh_quiet "lsblk -o FSTYPE 2>/dev/null | awk '/^(crypt|luks)\$/ {print; exit}'" || true)

    if [ "$home_fs" = "ecryptfs" ]; then
        _ok "client home is ecryptfs"
    elif [ -n "$disk_crypto" ]; then
        _ok "encrypted block device detected ($disk_crypto)"
    else
        _fail "no ecryptfs home or crypt/luks block device detected"
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "compliance doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "compliance doctor passed: $warnings warning(s)"
}

