# --- health ---
cmd_health() {
    local warn=""

    if ! _ssh_quiet "echo ok" >/dev/null; then
        osascript -e 'display notification "Workstation is OFFLINE" with title "work health" sound name "Basso"' 2>/dev/null
        echo "OFFLINE - workstation unreachable at $WORKSTATION_HOSTNAME"
        exit 1
    fi

    local metrics
    metrics=$(_ssh_quiet "
        ram_pct=\$(free | awk '/Mem/{printf \"%.0f\", \$3/\$2*100}')
        ram_used=\$(free -h | awk '/Mem/{print \$3}')
        ram_total=\$(free -h | awk '/Mem/{print \$2}')
        disk_pct=\$(df / | awk 'NR==2{gsub(/%/,\"\"); print \$5}')
        disk_used=\$(df -h / | awk 'NR==2{print \$3}')
        disk_total=\$(df -h / | awk 'NR==2{print \$2}')
        temp=\$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
        temp_c=\$((temp / 1000))
        load=\$(awk '{print \$1}' /proc/loadavg)
        docker_count=\$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')
        wg_count=\$(sudo -n wg show 2>/dev/null | grep -c 'interface' || echo 0)
        up=\$(uptime -p 2>/dev/null | sed 's/up //')
        echo \"ram_pct=\$ram_pct|ram=\${ram_used}/\${ram_total}|disk_pct=\$disk_pct|disk=\${disk_used}/\${disk_total}|temp=\${temp_c}|load=\$load|docker=\$docker_count|vpn=\$wg_count|up=\$up\"
    ")

    local ram_pct ram disk_pct disk temp load docker vpn up
    ram_pct=$(echo "$metrics" | cut -d'|' -f1 | cut -d'=' -f2)
    ram=$(echo "$metrics" | cut -d'|' -f2 | cut -d'=' -f2)
    disk_pct=$(echo "$metrics" | cut -d'|' -f3 | cut -d'=' -f2)
    disk=$(echo "$metrics" | cut -d'|' -f4 | cut -d'=' -f2)
    temp=$(echo "$metrics" | cut -d'|' -f5 | cut -d'=' -f2)
    load=$(echo "$metrics" | cut -d'|' -f6 | cut -d'=' -f2)
    docker=$(echo "$metrics" | cut -d'|' -f7 | cut -d'=' -f2)
    vpn=$(echo "$metrics" | cut -d'|' -f8 | cut -d'=' -f2)
    up=$(echo "$metrics" | cut -d'|' -f9 | cut -d'=' -f2)

    [ "$ram_pct" -gt 85 ] 2>/dev/null && warn="${warn}RAM critical (${ram_pct}%) "
    [ "$disk_pct" -gt 85 ] 2>/dev/null && warn="${warn}Disk critical (${disk_pct}%) "
    [ "$temp" -gt 75 ] 2>/dev/null && warn="${warn}Temp high (${temp}C) "

    echo "workstation  up $up"
    echo ""
    echo "  RAM    ${ram} (${ram_pct}%)"
    echo "  Disk   ${disk} (${disk_pct}%)"
    echo "  Temp   ${temp}C"
    echo "  Load   ${load}"
    echo "  Docker ${docker} containers"
    echo "  VPN    ${vpn} active"

    if [ -n "$warn" ]; then
        echo ""
        echo "  WARN: $warn"
        local safe_warn
        safe_warn=$(echo "$warn" | tr -cd '[:alnum:] %().')
        osascript -e "display notification \"$safe_warn\" with title \"work health\" sound name \"Basso\"" 2>/dev/null
    fi
}

cmd_watch() {
    echo "Monitoring workstation (Ctrl+C to stop)..."
    while true; do
        clear
        cmd_health
        sleep "${1:-30}"
    done
}

# --- report ---
# Merges Mac local log + each workstation client's log (iterates client users)
cmd_report() {
    local period="${1:---week}"
    local local_log="${XDG_DATA_HOME:-$HOME/.local/share}/work-tracker/log.tsv"
    local tmp_dir tmp sorted

    if ! command -v work-tracker >/dev/null 2>&1; then
        echo "work report requires work-tracker on the local machine" >&2
        echo "run: ./install" >&2
        exit 1
    fi

    tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/work-report.XXXXXX")"
    tmp="$tmp_dir/merged.tsv"
    sorted="$tmp_dir/sorted.tsv"
    trap 'rm -rf "$tmp_dir"' EXIT

    printf 'timestamp\tevent\tclient\tproject\tsource\n' > "$tmp"

    # Mac local log
    [ -f "$local_log" ] && tail -n +2 "$local_log" | awk -F'\t' 'NF==5 && $1 ~ /^[0-9]+$/ && $2 ~ /^(start|stop|tick)$/ {print}' >> "$tmp"

    # Iterate client users on the workstation and pull each log (via admin sudo)
    local clients
    clients=$(_list_clients || true)
    if [ -z "$clients" ]; then
        echo "warn no workstation clients found or workstation unreachable; local tracker report only" >&2
    fi
    if [ -n "$clients" ]; then
        local can_sudo=0
        if _ssh_quiet "sudo -n true"; then
            can_sudo=1
        else
            echo "warn workstation sudo unavailable; client tracker logs skipped" >&2
        fi
        while IFS= read -r client; do
            [ -z "$client" ] && continue
            [ "$can_sudo" -eq 1 ] || continue
            local client_log
            client_log=$(_ssh_quiet "sudo -n cat /home/$client/.local/share/work-tracker/log.tsv 2>/dev/null") || true
            [ -n "$client_log" ] && printf '%s\n' "$client_log" | tail -n +2 | awk -F'\t' 'NF==5 && $1 ~ /^[0-9]+$/ && $2 ~ /^(start|stop|tick)$/ {print}' >> "$tmp"
        done <<< "$clients"
    fi

    # Sort and dedup
    printf 'timestamp\tevent\tclient\tproject\tsource\n' > "$sorted"
    tail -n +2 "$tmp" | sort -t"$(printf '\t')" -k1,1n | uniq >> "$sorted"

    WORK_TRACKER_LOG="$sorted" work-tracker report "$period"
    rm -rf "$tmp_dir"
    trap - EXIT
}

# --- ssh-keygen ---
# Generates an SSH key on the workstation inside the CLIENT user's home (not admin's)
cmd_ssh_keygen() {
    local client="$1"
    local host="${2:-github.com}"

    if [ -z "$client" ]; then
        echo "Usage: work ssh-keygen <client> [host]"
        echo ""
        echo "Generates an SSH key in the client's home on the workstation"
        echo ""
        echo "Examples:"
        echo "  work ssh-keygen acme                 # github.com (default)"
        echo "  work ssh-keygen acme gitlab.com"
        echo "  work ssh-keygen acme bitbucket.org"
        exit 1
    fi

    _validate_client_name "$client"

    local key_name="${client}_ed25519"
    local ssh_alias="${host}-${client}"

    _ssh_as "$client" "
        set -e
        mkdir -p ~/.ssh/config.d && chmod 700 ~/.ssh ~/.ssh/config.d

        if [ -f ~/.ssh/$key_name ]; then
            echo 'Key already exists: ~/.ssh/$key_name'
        else
            ssh-keygen -t ed25519 -C '${client}@workstation' -f ~/.ssh/$key_name -N ''
            echo 'Key generated: ~/.ssh/$key_name'
        fi

        cat > ~/.ssh/config.d/$host << SSHCONF
# $host
Host $ssh_alias
    HostName $host
    User git
    IdentityFile ~/.ssh/$key_name
    IdentitiesOnly yes
SSHCONF
        chmod 600 ~/.ssh/config.d/$host
        echo 'SSH config: ~/.ssh/config.d/$host'

        if ! grep -q 'Include config.d/\\*' ~/.ssh/config 2>/dev/null; then
            { echo 'Include config.d/*'; cat ~/.ssh/config 2>/dev/null; } > ~/.ssh/config.tmp
            mv ~/.ssh/config.tmp ~/.ssh/config
            chmod 600 ~/.ssh/config
            echo 'Added Include config.d/* to ~/.ssh/config'
        fi

        echo ''
        echo '=== Public key (copy to $host) ==='
        echo ''
        cat ~/.ssh/${key_name}.pub
        echo ''
        echo '=== Clone with ==='
        echo 'git clone $ssh_alias:org/repo.git'
    "
}

# --- tracker-status ---
# shellcheck disable=SC2016
_tracker_remote_script='
set -e

ok() { echo "ok   $*"; }
warn() { echo "warn $*"; warnings=$((warnings + 1)); }
fail() { echo "fail $*"; failures=$((failures + 1)); }

check_user() {
    user="$1"
    home="$(getent passwd "$user" | cut -d: -f6)"
    [ -n "$home" ] || { fail "$user home not found"; return; }

    echo ""
    echo "== $user =="

    if [ -x "$home/.local/bin/work-tracker" ]; then
        ok "work-tracker installed"
    else
        fail "work-tracker missing"
    fi

    if sudo -n -u "$user" test -w "$home/.local/share/work-tracker" 2>/dev/null || sudo -n -u "$user" mkdir -p "$home/.local/share/work-tracker" 2>/dev/null; then
        ok "work-tracker data directory writable"
    else
        fail "work-tracker data directory not writable"
    fi

    if sudo -n -u "$user" "$home/.local/bin/work-tracker" status >/dev/null 2>&1; then
        ok "work-tracker status runs"
    else
        fail "work-tracker status failed"
    fi

    crontab_text="$(sudo -n -u "$user" crontab -l 2>/dev/null || true)"
    if printf "%s\n" "$crontab_text" | grep -qF "$home/.local/bin/work-tracker pulse"; then
        ok "pulse cron installed"
    else
        warn "pulse cron missing"
    fi
    if printf "%s\n" "$crontab_text" | grep -qF "$home/.local/bin/work-tracker monthly-save"; then
        ok "monthly-save cron installed"
    else
        warn "monthly-save cron missing"
    fi

    if sudo -n -u "$user" sh -lc "command -v tmux >/dev/null 2>&1"; then
        ok "tmux available"
    else
        warn "tmux unavailable"
    fi
}
'

cmd_tracker_doctor() {
    local client="${1:-}"
    [ -n "$client" ] && _validate_client_name "$client"

    echo "tracker doctor"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    [ -n "$client" ] && echo "  client:      $client"
    echo ""

    echo "== Local =="
    if command -v work-tracker >/dev/null 2>&1; then
        echo "ok   work-tracker installed on Mac"
        if work-tracker status >/dev/null 2>&1; then
            echo "ok   local work-tracker status runs"
        else
            echo "warn local work-tracker status failed"
        fi
    else
        echo "warn work-tracker missing on Mac"
    fi

    _ssh_data "CLIENT='$client' WORKSTATION_ADMIN_USER='$WORKSTATION_ADMIN_USER' bash -s" <<REMOTE
$_tracker_remote_script
failures=0
warnings=0

if ! sudo -n true >/dev/null 2>&1; then
    echo "info workstation sudo unavailable; client tracker checks are limited"
    if [ -n "\$CLIENT" ]; then
        echo "     run on the workstation with sudo: sudo ~/.local/bin/work tracker-doctor \$CLIENT"
    else
        echo "     run on the workstation with sudo: sudo ~/.local/bin/work tracker-doctor"
    fi
    exit 0
fi

if [ -n "\$CLIENT" ]; then
    if id "\$CLIENT" >/dev/null 2>&1; then
        check_user "\$CLIENT"
    else
        fail "client user does not exist: \$CLIENT"
    fi
else
    clients=\$(getent passwd | awk -F: -v admin="\$WORKSTATION_ADMIN_USER" '\$3>=1000 && \$1!=admin && \$1!="nobody" && \$1!="encryption_user" && \$7 !~ /(nologin|false)\$/ && \$6 ~ /^\\/home\\// {print \$1}' | sort)
    if [ -z "\$clients" ]; then
        warn "no client users found"
    else
        while IFS= read -r user; do
            [ -z "\$user" ] && continue
            check_user "\$user"
        done <<EOF
\$clients
EOF
    fi
fi

echo ""
if [ "\$failures" -gt 0 ]; then
    echo "tracker doctor failed: \$failures failure(s), \$warnings warning(s)"
    exit 1
fi
echo "tracker doctor passed: \$warnings warning(s)"
REMOTE
}

cmd_tracker_repair() {
    local client="${1:-}"
    if [ -z "$client" ]; then
        echo "Usage: work tracker-repair <client|--all>"
        echo "Repairs the client work-tracker symlink, data dir, and cron entries."
        exit 1
    fi
    [ "$client" = "--all" ] || _validate_client_name "$client"

    echo "tracker repair"
    echo "  workstation: $WORKSTATION_ADMIN_USER@$WORKSTATION_HOSTNAME"
    if [ "$client" = "--all" ]; then
        echo "  scope:       all clients"
    else
        echo "  client:      $client"
    fi
    echo ""

    _ssh_data "CLIENT='$client' WORKSTATION_ADMIN_USER='$WORKSTATION_ADMIN_USER' bash -s" <<'REMOTE'
set -e

if ! sudo -n true >/dev/null 2>&1; then
    echo "tracker-repair requires sudo on the workstation" >&2
    echo "run on workstation: sudo ~/.local/bin/work tracker-repair ${CLIENT}" >&2
    exit 1
fi

repair_user() {
    user="$1"

    if ! id "$user" >/dev/null 2>&1; then
        echo "fail client user does not exist: $user" >&2
        return 1
    fi

    home="$(getent passwd "$user" | cut -d: -f6)"
    repo="$home/.dotfiles"
    tracker="$repo/scripts/work-tracker"

    echo "== $user =="

    if ! sudo -n test -x "$tracker"; then
        echo "fail client dotfiles work-tracker missing or not executable: $tracker" >&2
        return 1
    fi

    sudo -n -u "$user" mkdir -p "$home/.local/bin" "$home/.local/share/work-tracker"
    sudo -n -u "$user" ln -sf "$tracker" "$home/.local/bin/work-tracker"
    sudo -n -u "$user" test -f "$home/.local/share/work-tracker/log.tsv" || \
        sudo -n -u "$user" sh -c "printf 'timestamp\\tevent\\tclient\\tproject\\tsource\\n' > '$home/.local/share/work-tracker/log.tsv'"

    cron_lines="$(sudo -n -u "$user" "$home/.local/bin/work-tracker" cron-lines "$home/.local/bin/work-tracker")"
    tmp="$(mktemp)"
    sudo -n -u "$user" crontab -l 2>/dev/null | grep -vF "$home/.local/bin/work-tracker pulse" | grep -vF "$home/.local/bin/work-tracker monthly-save" > "$tmp" || true
    {
        cat "$tmp"
        printf '%s\n' "$cron_lines"
    } | sudo -n -u "$user" crontab -
    rm -f "$tmp"

    sudo -n -u "$user" "$home/.local/bin/work-tracker" status >/dev/null

    echo "ok   work-tracker symlink repaired"
    echo "ok   work-tracker data directory ready"
    echo "ok   work-tracker crons installed"
    echo "ok   work-tracker status runs"
}

if [ "$CLIENT" = "--all" ]; then
    clients=$(getent passwd | awk -F: -v admin="$WORKSTATION_ADMIN_USER" '$3>=1000 && $1!=admin && $1!="nobody" && $1!="encryption_user" && $7 !~ /(nologin|false)$/ && $6 ~ /^\/home\// {print $1}' | sort)
    if [ -z "$clients" ]; then
        echo "warn no client users found"
        exit 0
    fi

    while IFS= read -r user; do
        [ -z "$user" ] && continue
        repair_user "$user"
        echo ""
    done <<EOF
$clients
EOF
else
    repair_user "$CLIENT"
fi
REMOTE
}

cmd_tracker_status() {
    echo "=== Local (Mac) ==="
    if command -v work-tracker >/dev/null 2>&1; then
        work-tracker status
    else
        echo "  (missing: run ./install)"
    fi
    echo ""

    local clients
    clients=$(_list_clients || true)
    if [ -z "$clients" ]; then
        echo "(no client users on workstation or workstation unreachable)"
        return
    fi

    local can_sudo=0
    if _ssh_quiet "sudo -n true"; then
        can_sudo=1
    else
        echo "info workstation sudo unavailable; client tracker status is limited"
        echo ""
    fi

    while IFS= read -r client; do
        [ -z "$client" ] && continue
        echo "=== Workstation: $client ==="
        if [ "$can_sudo" -eq 1 ]; then
            _ssh_quiet "sudo -n -u $client /home/$client/.local/bin/work-tracker status 2>/dev/null" || echo "  (unreachable)"
        else
            echo "  (skipped: sudo unavailable)"
        fi
        echo ""
    done <<< "$clients"
}

# --- version ---
# Reports the current dotfiles repo state on this device and how far it is from
# `origin/main`, so you can spot devices that fell behind your WoW.
cmd_version() {
    local repo="$HOME/.dotfiles"
    if [ ! -d "$repo/.git" ]; then
        echo "version: $repo is not a git repo" >&2
        exit 1
    fi

    local branch sha date dirty
    branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo "?")
    date=$(git -C "$repo" log -1 --format=%cd --date=iso-local 2>/dev/null || echo "?")
    if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
        dirty="yes"
    else
        dirty="no"
    fi

    echo "dotfiles version"
    echo "  path:     $repo"
    echo "  branch:   $branch"
    echo "  sha:      $sha"
    echo "  date:     $date"
    echo "  dirty:    $dirty"

    if git -C "$repo" fetch --quiet origin main 2>/dev/null; then
        local ahead behind
        ahead=$(git -C "$repo" rev-list --count origin/main..HEAD 2>/dev/null || echo "?")
        behind=$(git -C "$repo" rev-list --count HEAD..origin/main 2>/dev/null || echo "?")
        echo "  vs origin/main:  ahead $ahead, behind $behind"
        if [ "$behind" != "0" ] && [ "$behind" != "?" ]; then
            echo ""
            echo "Device out of date. Sync with: git -C $repo pull && $repo/install"
        fi
    else
        echo "  vs origin/main:  (fetch failed; check network or repo remote)"
    fi
}

# Hard dependency check — workmux is part of the WoW (drives tmux-layout via
# the shared config). Diagnostic commands (help/version/legacy) bypass this so
# you can still introspect a half-set-up device.
_require_workmux() {
    if command -v workmux >/dev/null 2>&1; then
        return 0
    fi
    echo "work: workmux is required but not installed on this device" >&2
    echo "  install:  brew install raine/workmux/workmux" >&2
    echo "  or full:  brew bundle --file=~/.dotfiles/macos/Brewfile" >&2
    echo "  bypass:   work version | work help | work legacy" >&2
    exit 1
}

