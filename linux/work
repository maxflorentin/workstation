            client_shell=$(_ssh_quiet "getent passwd '$client' | cut -d: -f7" || true)
            if [ "$home_mode" = "700" ]; then
                _ok "home mode is 700"
            else
                _warn "home mode is ${home_mode:-unknown}, expected 700"
            fi
            if [ "$client_shell" = "/bin/zsh" ] || [ "$client_shell" = "/usr/bin/zsh" ]; then
                _ok "login shell is zsh"
            else
                _warn "login shell is ${client_shell:-unknown}"
            fi
            if [ "$admin_sudo" -eq 1 ]; then
                if _ssh_quiet "sudo -n test -d /home/$client/.dotfiles"; then
                    _ok "client dotfiles present"
                else
                    _warn "client dotfiles missing"
                fi
                if _ssh_quiet "sudo -n test -f /home/$client/.clientrc"; then
                    _ok "client .clientrc present"
                    local clientrc_meta
                    clientrc_meta=$(_ssh_quiet "sudo -n stat -c '%U:%G %a' /home/$client/.clientrc" || true)
                    if [ "$clientrc_meta" = "$client:$client 600" ]; then
                        _ok "client .clientrc owner/mode sane"
                    else
                        _warn "client .clientrc owner/mode is ${clientrc_meta:-unknown}, expected $client:$client 600"
                    fi
                else
                    _warn "client .clientrc missing"
                fi
                if _ssh_quiet "sudo -n test -x /home/$client/.local/bin/work-tracker"; then
                    _ok "client work-tracker installed"
                else
                    _warn "client work-tracker missing"
                fi
                if _ssh_quiet "sudo -n -u '$client' crontab -l 2>/dev/null | grep -qF 'work-tracker pulse'"; then
                    _ok "client work-tracker pulse cron installed"
                else
                    _warn "client work-tracker pulse cron missing"
                fi
                if _ssh_quiet "sudo -n -u '$client' crontab -l 2>/dev/null | grep -qF 'work-tracker monthly-save'"; then
                    _ok "client work-tracker monthly-save cron installed"
                else
                    _warn "client work-tracker monthly-save cron missing"
                fi
                if _ssh_quiet "sudo -n -u '$client' /home/$client/.local/bin/work-tracker status >/dev/null"; then
                    _ok "client work-tracker status runs"
                else
                    _warn "client work-tracker status failed"
                fi
            else
                echo "info skipping client dotfile checks because passwordless sudo is unavailable"
            fi
            if _ssh_quiet "id -nG '$client' | tr ' ' '\n' | grep -qx docker"; then
                _warn "client is in docker group (privileged host access)"
            else
                _ok "client not in docker group"
            fi
        fi
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "workstation doctor failed: $failures failure(s), $warnings warning(s)"
        exit 1
    fi

    echo "workstation doctor passed: $warnings warning(s)"
}

# --- status ---
cmd_status() {
    if ! _ssh_quiet "echo ok" >/dev/null; then
        echo "Workstation is offline or unreachable at $PI_HOST"
        exit 1
    fi

    if _ssh_quiet "command -v fastfetch" >/dev/null; then
        _ssh_data "fastfetch"
    else
        _ssh_data 'bash -s' <<'REMOTE'
            echo "=== Workstation Status (install fastfetch: sudo apt install fastfetch) ==="
            echo ""
            echo "Host:    $(hostname)"
            echo "Uptime:  $(uptime -p 2>/dev/null || uptime | sed 's/.*up //')"
            free -h | awk '/^Mem/{printf "Memory:  %s / %s\n", $3, $2}'
            df -h / | awk 'NR==2{printf "Disk:    %s / %s (%s)\n", $3, $2, $5}'
            echo ""
            echo "Docker:  $(docker ps --format '{{.Names}}' 2>/dev/null | paste -sd ', ' || echo none)"
            echo "VPN:     $(sudo -n wg show 2>/dev/null | awk '/^interface:/{printf "%s ", $2}' || echo none)"
            echo "Clients: $(getent passwd | awk -F: '$3>=1000 && $1!="nobody" {print $1}' | paste -sd ', ')"
REMOTE
    fi
}

# --- sync ---
cmd_sync() {
    local client="$1"
    local dir="${2:-.}"
    local target="${3:-$(basename "$(cd "$dir" && pwd)")}"

    if [ -z "$client" ]; then
        echo "Usage: work sync <client> [local-dir] [remote-subdir]"
        echo "Syncs local dir to /home/<client>/<remote-subdir>/"
        exit 1
    fi
    _validate_client_name "$client"

    rsync -avz --exclude '.git' --exclude 'node_modules' --exclude '.venv' --exclude '__pycache__' \
        "$dir/" "$client@$PI_HOST:~/$target/"
    echo "Synced to $client@$PI_HOST:~/$target/"
}

# --- destroy ---
cmd_destroy() {
    local client="$1"
    if [ -z "$client" ]; then
        echo "Usage: work destroy <client>"
        exit 1
    fi
    _validate_client_name "$client"

    echo "This will PERMANENTLY delete client '$client' on the workstation:"
    echo "  - Linux user + home (/home/$client)"
    echo "  - SSH authorized_keys (/etc/ssh/authorized_keys/$client)"
    echo "  - WireGuard VPN config (if exists)"
    echo "  - Active tmux sessions"
    echo ""
    read -r -p "Type 'yes' to confirm: " confirm
    if [ "$confirm" != "yes" ]; then
        echo "Aborted."
        exit 0
    fi

    _ssh_data "sudo CLIENT='$client' bash -s" <<'REMOTE'
set -e

# Kill any running processes for this user
pkill -u "$CLIENT" 2>/dev/null || true
sleep 1
pkill -9 -u "$CLIENT" 2>/dev/null || true

# Remove user + home
if id "$CLIENT" &>/dev/null; then
    userdel -r "$CLIENT" 2>/dev/null || userdel -rf "$CLIENT" 2>/dev/null || true
    echo "  user $CLIENT removed"
fi

# Clean up SSH keys
rm -f "/etc/ssh/authorized_keys/$CLIENT"

# Clean up VPN config
rm -f "/etc/wireguard/$CLIENT.conf"

# Clean up any leftover home directory
rm -rf "/home/$CLIENT"
REMOTE

    echo "Client '$client' destroyed."
}

# --- browse ---
_browse_proxy_port() {
    local client="$1"
    echo $(( 1080 + $(printf '%s' "$client" | cksum | cut -d' ' -f1) % 1000 ))
}

_browse_chrome_dir() {
    local client="$1"
    echo "$HOME/.chrome-clients/$client"
}

cmd_browse() {
    local client="${1:-}"
    if [ -z "$client" ]; then
        echo "Usage: work browse [--status] <client>"
        echo "Opens isolated Chrome routed through workstation network/VPN"
        exit 1
    fi
    local mode="open"
    if [ "$client" = "--status" ]; then
        mode="status"
        client="${2:-}"
        if [ -z "$client" ]; then
            echo "Usage: work browse --status <client>"
            exit 1
        fi
    fi
    _validate_client_name "$client"

    local proxy_port chrome_dir
    proxy_port="$(_browse_proxy_port "$client")"
    chrome_dir="$(_browse_chrome_dir "$client")"

    if [ "$mode" = "status" ]; then
        echo "browse status"
        echo "  client:  $client"
        echo "  proxy:   127.0.0.1:$proxy_port"
        echo "  profile: $chrome_dir"
        if lsof -i ":$proxy_port" &>/dev/null; then
            echo "  state:   proxy running"
        else
            echo "  state:   proxy stopped"
        fi
        return
    fi

    if ! lsof -i ":$proxy_port" &>/dev/null; then
        echo "Starting SOCKS proxy for $client on port $proxy_port..."
        ssh -D "127.0.0.1:$proxy_port" -N -f "$PI_USER@$PI_HOST"
    fi

    echo "Opening Chrome for client '$client'..."
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
        --proxy-server="socks5://127.0.0.1:$proxy_port" \
        --host-resolver-rules="MAP * ~NOTFOUND , EXCLUDE 127.0.0.1" \
        --user-data-dir="$chrome_dir" \
        --no-first-run \
        &>/dev/null &

    echo "Chrome running with workstation network (proxy :$proxy_port). Stop with: work browse-stop $client"
}

cmd_browse_stop() {
    local client="${1:-}"
    if [ -n "$client" ]; then
        _validate_client_name "$client"
        local proxy_port
        proxy_port="$(_browse_proxy_port "$client")"
        local pid
        pid=$(lsof -ti ":$proxy_port" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid"
            echo "SOCKS proxy stopped for $client (port $proxy_port)."
        else
            echo "No proxy running for $client on port $proxy_port."
        fi
    else
        local pids
        pids=$(pgrep -f 'ssh -D 127.0.0.1' 2>/dev/null || true)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill
            echo "All SOCKS proxies stopped."
        else
            echo "No proxies running."
        fi
    fi
}

# --- agvty (Antigravity via X11 forwarding) ---
cmd_agvty() {
    local client="$1"
    if [ -z "$client" ]; then
        echo "Usage: work agvty <client>"
        echo "Opens Antigravity on the server, displayed on Mac via X11 forwarding"
        echo ""
        echo "Requires XQuartz on Mac: brew install --cask xquartz"
        exit 1
    fi
    _validate_client_name "$client"

    # Ensure XQuartz is running
    if ! pgrep -q Xquartz 2>/dev/null; then
        echo "Starting XQuartz..."
        open -a XQuartz
        sleep 2
    fi

    echo "Launching Antigravity for $client via X11..."
    ssh -Y "$client@$PI_HOST" "antigravity" &>/dev/null &
    echo "Antigravity running (X11 → Mac). Close the app window to stop."
}

cmd_agvty_stop() {
    local client="${1:-}"
    if [ -n "$client" ]; then
        _validate_client_name "$client"
        local pids
        pids=$(pgrep -f "ssh -Y $client@.*antigravity" 2>/dev/null || true)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill
            echo "Antigravity stopped for $client."
        else
            echo "No Antigravity session for $client."
        fi
    else
        local pids
        pids=$(pgrep -f 'ssh -Y.*antigravity' 2>/dev/null || true)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill
            echo "All Antigravity sessions stopped."
        else
            echo "No Antigravity sessions running."
        fi
    fi
}

# --- health ---
cmd_health() {
    local warn=""

    if ! _ssh_quiet "echo ok" >/dev/null; then
        osascript -e 'display notification "Workstation is OFFLINE" with title "work health" sound name "Basso"' 2>/dev/null
        echo "OFFLINE - workstation unreachable at $PI_HOST"
        exit 1
    fi

    local metrics
    metrics=$(_ssh_quiet "
        ram_pct=\$(free | awk '/Mem/{printf \"%.0f\", \$3/\$2*100}')
        ram_used=\$(free -h | awk '/Mem/{print \$3}')
        ram_total=\$(free -h | awk '/Mem/{print \$2}')
        disk_pct=\$(df / | awk 'NR==2{gsub(/%/,\"\"); print \$5}')
        disk_used=\$(df -h / | awk 'NR==2{print \$3}')
        disk_total=\$(df -h / | awk 'NR==2{print \$2}')
        temp=\$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
        temp_c=\$((temp / 1000))
        load=\$(awk '{print \$1}' /proc/loadavg)
        docker_count=\$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')
        wg_count=\$(sudo -n wg show 2>/dev/null | grep -c 'interface' || echo 0)
        up=\$(uptime -p 2>/dev/null | sed 's/up //')
        echo \"ram_pct=\$ram_pct|ram=\${ram_used}/\${ram_total}|disk_pct=\$disk_pct|disk=\${disk_used}/\${disk_total}|temp=\${temp_c}|load=\$load|docker=\$docker_count|vpn=\$wg_count|up=\$up\"
    ")

    local ram_pct ram disk_pct disk temp load docker vpn up
    ram_pct=$(echo "$metrics" | cut -d'|' -f1 | cut -d'=' -f2)
    ram=$(echo "$metrics" | cut -d'|' -f2 | cut -d'=' -f2)
    disk_pct=$(echo "$metrics" | cut -d'|' -f3 | cut -d'=' -f2)
    disk=$(echo "$metrics" | cut -d'|' -f4 | cut -d'=' -f2)
    temp=$(echo "$metrics" | cut -d'|' -f5 | cut -d'=' -f2)
    load=$(echo "$metrics" | cut -d'|' -f6 | cut -d'=' -f2)
    docker=$(echo "$metrics" | cut -d'|' -f7 | cut -d'=' -f2)
    vpn=$(echo "$metrics" | cut -d'|' -f8 | cut -d'=' -f2)
    up=$(echo "$metrics" | cut -d'|' -f9 | cut -d'=' -f2)

    [ "$ram_pct" -gt 85 ] 2>/dev/null && warn="${warn}RAM critical (${ram_pct}%) "
    [ "$disk_pct" -gt 85 ] 2>/dev/null && warn="${warn}Disk critical (${disk_pct}%) "
    [ "$temp" -gt 75 ] 2>/dev/null && warn="${warn}Temp high (${temp}C) "

    echo "workstation  up $up"
    echo ""
    echo "  RAM    ${ram} (${ram_pct}%)"
    echo "  Disk   ${disk} (${disk_pct}%)"
    echo "  Temp   ${temp}C"
    echo "  Load   ${load}"
    echo "  Docker ${docker} containers"
    echo "  VPN    ${vpn} active"

    if [ -n "$warn" ]; then
        echo ""
        echo "  WARN: $warn"
        local safe_warn
        safe_warn=$(echo "$warn" | tr -cd '[:alnum:] %().')
        osascript -e "display notification \"$safe_warn\" with title \"work health\" sound name \"Basso\"" 2>/dev/null
    fi
}

cmd_watch() {
    echo "Monitoring workstation (Ctrl+C to stop)..."
    while true; do
        clear
        cmd_health
        sleep "${1:-30}"
    done
}

# --- report ---
# Merges Mac local log + each workstation client's log (iterates client users)
cmd_report() {
    local period="${1:---week}"
    local local_log="${XDG_DATA_HOME:-$HOME/.local/share}/work-tracker/log.tsv"
    local tmp="/tmp/work-tracker-merged-$$.tsv"
    local sorted="/tmp/work-tracker-sorted-$$.tsv"

    printf 'timestamp\tevent\tclient\tproject\tsource\n' > "$tmp"

    # Mac local log
    [ -f "$local_log" ] && tail -n +2 "$local_log" >> "$tmp"

    # Iterate client users on the workstation and pull each log (via admin sudo)
    local clients
    clients=$(_list_clients)
    if [ -n "$clients" ]; then
        while IFS= read -r client; do
            [ -z "$client" ] && continue
            local client_log
            client_log=$(_ssh_quiet "sudo cat /home/$client/.local/share/work-tracker/log.tsv 2>/dev/null") || true
            [ -n "$client_log" ] && echo "$client_log" | tail -n +2 >> "$tmp"
        done <<< "$clients"
    fi

    # Sort and dedup
    printf 'timestamp\tevent\tclient\tproject\tsource\n' > "$sorted"
    tail -n +2 "$tmp" | sort -t"$(printf '\t')" -k1,1n | uniq >> "$sorted"

    WORK_TRACKER_LOG="$sorted" work-tracker report "$period"
    rm -f "$tmp" "$sorted"
}

# --- ssh-keygen ---
# Generates an SSH key on the workstation inside the CLIENT user's home (not admin's)
cmd_ssh_keygen() {
    local client="$1"
    local host="${2:-github.com}"

    if [ -z "$client" ]; then
        echo "Usage: work ssh-keygen <client> [host]"
        echo ""
        echo "Generates an SSH key in the client's home on the workstation"
        echo ""
        echo "Examples:"
        echo "  work ssh-keygen acme                 # github.com (default)"
        echo "  work ssh-keygen acme gitlab.com"
        echo "  work ssh-keygen acme bitbucket.org"
        exit 1
    fi

    _validate_client_name "$client"

    local key_name="${client}_ed25519"
    local ssh_alias="${host}-${client}"

    _ssh_as "$client" "
        set -e
        mkdir -p ~/.ssh/config.d && chmod 700 ~/.ssh ~/.ssh/config.d

        if [ -f ~/.ssh/$key_name ]; then
            echo 'Key already exists: ~/.ssh/$key_name'
        else
            ssh-keygen -t ed25519 -C '${client}@workstation' -f ~/.ssh/$key_name -N ''
            echo 'Key generated: ~/.ssh/$key_name'
        fi

        cat > ~/.ssh/config.d/$host << SSHCONF
# $host
Host $ssh_alias
    HostName $host
    User git
    IdentityFile ~/.ssh/$key_name
    IdentitiesOnly yes
SSHCONF
        chmod 600 ~/.ssh/config.d/$host
        echo 'SSH config: ~/.ssh/config.d/$host'

        if ! grep -q 'Include config.d/\\*' ~/.ssh/config 2>/dev/null; then
            { echo 'Include config.d/*'; cat ~/.ssh/config 2>/dev/null; } > ~/.ssh/config.tmp
            mv ~/.ssh/config.tmp ~/.ssh/config
            chmod 600 ~/.ssh/config
            echo 'Added Include config.d/* to ~/.ssh/config'
        fi

        echo ''
        echo '=== Public key (copy to $host) ==='
        echo ''
        cat ~/.ssh/${key_name}.pub
        echo ''
        echo '=== Clone with ==='
        echo 'git clone $ssh_alias:org/repo.git'
    "
}

# --- tracker-status ---
cmd_tracker_status() {
    echo "=== Local (Mac) ==="
    work-tracker status
    echo ""

    local clients
    clients=$(_list_clients)
    if [ -z "$clients" ]; then
        echo "(no client users on workstation)"
        return
    fi

    while IFS= read -r client; do
        [ -z "$client" ] && continue
        echo "=== Workstation: $client ==="
        _ssh_quiet "sudo -u $client /home/$client/.local/bin/work-tracker status 2>/dev/null" || echo "  (unreachable)"
        echo ""
    done <<< "$clients"
}

